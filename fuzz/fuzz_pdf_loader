#!/usr/bin/env python3
"""ClusterFuzzLite fuzzing target wrapper for PDF loading.

This wrapper imports and executes the actual Python fuzzing harness for ClusterFuzzLite/OSS-Fuzz.
Fuzz targets must be executable files without .py extension for ClusterFuzzLite detection.
"""
import os
import sys

# Add directories to Python path for imports
fuzz_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(fuzz_dir, "..", "src"))
sys.path.insert(0, fuzz_dir)

# Import the fuzzing harness module
import fuzz_pdf_loader  # noqa: E402

# Expose TestOneInput for ClusterFuzzLite detection
TestOneInput = fuzz_pdf_loader.TestOneInput  # noqa: F401

# Execute main entry point
if __name__ == "__main__":
    fuzz_pdf_loader.main()
