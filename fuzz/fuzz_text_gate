#!/bin/bash
# ClusterFuzzLite fuzzing target wrapper for text detection gate
# Executes the Python fuzzing harness with proper environment setup

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}/../src:${SCRIPT_DIR}:${PYTHONPATH}"

exec python3 "${SCRIPT_DIR}/fuzz_text_gate.py" "$@"
