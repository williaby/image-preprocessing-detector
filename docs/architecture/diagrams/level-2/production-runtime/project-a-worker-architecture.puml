@startuml project-a-worker-architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam dpi 150
skinparam shadowing false

skinparam note {
  BackgroundColor #F8F8F8
  BorderColor #BBBBBB
}

skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}

title Project A - Celery Worker Architecture & API Layer
footer Project A - Worker Infrastructure | v1.0 | February 2026

' ============================================================================
' CLIENT LAYER (FastAPI)
' ============================================================================

package "Client Layer (FastAPI)" as ClientLayer #E8F5E9 {
  component "FastAPI App\n(api/app.py)" as FastAPI
  component "/health, /ready\n/version" as HealthRoutes
  component "/process\n(single file upload)" as ProcessRoute
  component "/batch\n(multi-file upload)" as BatchRoute

  FastAPI --> HealthRoutes
  FastAPI --> ProcessRoute
  FastAPI --> BatchRoute
}

' ============================================================================
' MIDDLEWARE STACK
' ============================================================================

package "Middleware Stack" as Middleware #E8F5E9 {
  note as MiddlewareNote
    **Middleware Order (applied in sequence):**
    1. CORSMiddleware (allow_origins: ["*"])
    2. RequestLoggingMiddleware (correlation ID, timing)
    3. RateLimitMiddleware (100 req/60s, sliding window)
    4. APIKeyAuthMiddleware (X-API-Key header, public paths bypass)
  end note
}

' ============================================================================
' MESSAGE BROKER (Redis)
' ============================================================================

package "Message Broker" as Broker #FFF3E0 {
  database "Redis" as Redis {
    artifact "db0: Message Broker" as db0
    artifact "db1: Result Backend" as db1
  }

  component "default Exchange\n(direct)" as DefaultExchange
  component "gpu Exchange\n(direct, priority=10)" as GPUExchange
  component "batch Exchange\n(direct)" as BatchExchange

  Redis --> DefaultExchange
  Redis --> GPUExchange
  Redis --> BatchExchange
}

' ============================================================================
' WORKER POOLS
' ============================================================================

package "Worker Pools" as Workers #E8F5E9 {
  component "Default Workers\n(concurrency: 4)\n\nprocess_single_document\n2 retries, 180s/240s timeout" as DefaultWorker
  component "GPU Workers\n(concurrency: 2, pool=solo)\n\nrun_iqa_analysis\n3 retries, 120s/180s timeout" as GPUWorker
  component "Batch Workers\n(concurrency: 1)\n\nprocess_batch_documents\n600s/900s timeout" as BatchWorker
}

' ============================================================================
' IQA TASK (Lazy Loading)
' ============================================================================

package "IQATask (Lazy Loading)" as IQATask #E8F5E9 {
  component "Student ONNX Session\n(ResNet-18)" as StudentModel
  component "Teacher ONNX Session\n(ResNet-50)" as TeacherModel
  component "DeviceOrchestrator" as Orchestrator
  component "ModalClient\n(Circuit Breaker)" as ModalClient

  StudentModel --> Orchestrator
  TeacherModel --> Orchestrator
  Orchestrator --> ModalClient
}

' ============================================================================
' DEVICE ORCHESTRATION
' ============================================================================

package "Device Orchestration" as DeviceOrch #E8F5E9 {
  note as OrchNote
    **Device Priority Logic:**

    **Student Model:**
    - Always local inference
    - force_device OR cuda OR cpu
    - CPU always allowed (fast enough)

    **Teacher Model:**
    - Budget check -> cuda -> modal -> cpu (qa/dev) -> BLOCK (production)
    - InferenceMode: production | qa | development
    - BudgetTracker: per-doc (10), per-batch (100), monthly (10.0 GPU-hrs)

    **Policy Enforcement:**
    - Production: BLOCK CPU inference for teacher
    - QA/Dev: Allow CPU as fallback
    - Budget exceeded: Fail fast with clear error
  end note
}

' ============================================================================
' CIRCUIT BREAKER (Modal)
' ============================================================================

package "Circuit Breaker (Modal)" as CircuitBreaker #FFEBEE {
  note as CBNote
    **State Machine:**
    CLOSED --[3 failures]--> OPEN
    OPEN --[60s timeout]--> HALF_OPEN
    HALF_OPEN --[2 successes]--> CLOSED
    HALF_OPEN --[1 failure]--> OPEN

    **Request:**
    - Input: image_array + model_version
    - Output: scores + confidences

    **Retry:**
    - 3 attempts, exponential backoff (1-8s)
    - ±25% jitter to prevent thundering herd
  end note
}

' ============================================================================
' MONITORING
' ============================================================================

package "Monitoring" as Monitoring #E8F5E9 {
  component "Flower Dashboard\n(:5555)" as Flower
  component "Prometheus Metrics" as Prometheus
  component "Structured Logging\n(structlog + correlation IDs)" as Logging
}

' ============================================================================
' DATA FLOW CONNECTIONS
' ============================================================================

' FastAPI -> Redis Exchanges (via Celery .apply_async())
ProcessRoute --> DefaultExchange : Celery\n.apply_async()
ProcessRoute --> GPUExchange : IQA analysis\n(high priority)
BatchRoute --> BatchExchange : Batch processing

' Exchanges -> Worker Pools (routing keys)
DefaultExchange --> DefaultWorker : Routing key:\ndefault
GPUExchange --> GPUWorker : Routing key:\ngpu (priority=10)
BatchExchange --> BatchWorker : Routing key:\nbatch

' GPU Worker -> IQA Components
GPUWorker --> IQATask : Load ONNX\nsessions

' IQA Task -> Modal Circuit Breaker
ModalClient --> CircuitBreaker : Remote GPU\ninference

' Workers -> Monitoring
DefaultWorker --> Logging
GPUWorker --> Logging
BatchWorker --> Logging

DefaultWorker --> Flower
GPUWorker --> Flower
BatchWorker --> Flower

GPUWorker --> Prometheus : Metrics:\nlatency, errors,\nbudget usage

' Middleware -> Client Layer
ClientLayer --> Middleware

