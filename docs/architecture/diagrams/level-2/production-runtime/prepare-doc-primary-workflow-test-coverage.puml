@startuml prepare-doc-primary-workflow-test-coverage
title Prepare-Doc - Primary Document Processing Workflow\n(High Level with Test Coverage)

skinparam dpi 150
skinparam shadowing false
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
  FontSize 9
}

start

partition "Input" {
  :Raw Document\n(any format);
  note right #LightGreen
    **Tests:**
    • test_image_loader.py
    • test_pdf_loader.py
    • test_schema.py::test_file_formats
    • test_pipeline_e2e.py::test_*
    • test_real_fixtures.py::TestRealPDFFixtures
    **FR:** FR-1.1, FR-1.2
  end note
}

partition "Ingestion & Pre-flight" {
  :DPI Detection &\nUpscaling (if needed);
  note right #LightGreen
    **Tests:**
    • test_pdf_resolution.py (12 tests)
    • test_pdf_upscaler.py (18 tests)
    • test_pdf_analyzer.py (8 tests)
    • test_pdf_upscaling_integration.py
    **FR:** FR-3.5, FR-3.6
  end note

  :PDF → Page Images\n(300 DPI target);
  note right #LightGreen
    **Tests:**
    • test_pdf_loader.py (21 tests)
    • test_image_loader.py (12 tests)
    **FR:** FR-3.4
  end note
}

partition "PDF Classification" {
  :Classify PDF Type\n(image_only / born_digital / hybrid);
  note right #LightGreen
    **Tests:**
    • test_pdf_type_classifier.py (14 tests)
    • test_pdf_image_detector.py (8 tests)
    • test_pdf_text_extractor.py (6 tests)
    • test_pdf_classification_integration.py (9 tests - SKIPPED)
    **FR:** FR-2.1
  end note
}

partition "Text Gate" {
  :Fast Text Detection\n(< 10ms heuristics);
  if (Text detected?) then (yes)
    :Text-detected path;
  else (no)
    :No-text path;
  endif
  note right #LightGreen
    **Tests:**
    • test_text_gate.py (15 tests)
      - test_text_detection_accuracy
      - test_stroke_density_computation
      - test_connected_components
      - test_edge_density_computation
      - test_confidence_weighting
      - test_decision_logic_*
    **FR:** FR-2.4
  end note
}

partition "IQA Analysis" {
  :Classical IQA\n(blur, noise, contrast, skew);
  note right #LightGreen
    **Tests:**
    • test_iqa_classical.py (52 tests)
    • test_blur_detector.py (20 tests)
    • test_corrections.py (38 tests)
    • test_image_metrics.py (benchmark)
    **FR:** FR-3.1, FR-3.3, FR-3.7, FR-3.2
  end note

  :ML IQA (Student)\nResNet-18 inference;
  if (High uncertainty?) then (yes)
    :Teacher inference\n(ResNet-50);
  endif
  note right #FFCCCC
    **LEGACY (Phase 3): ResNet-18/50 architecture**
    **superseded by MobileNetV4-Conv-S + SigLIP 2**
    **NAFlex two-model pipeline.**
    Current: MobileNetV4 (3ms) + SigLIP 2 (50ms, 22 heads)

    **Tests (Phase 3 legacy):**
    - test_iqa_ml.py (15 tests)
    - test_resnet_teacher.py (SKIPPED - torch)
    - test_loss_functions.py (SKIPPED - torch)
    - test_iqa_ml_integration.py
    **FR:** FR-2.3
    **Status:** Partial - ML models superseded
  end note
}

partition "Layout-Lite" #LightBlue {
  :Coarse page attributes\n(tables, figures, handwriting);
  :Structural complexity score;
  note right #Orange
    **Tests:**
    • test_phase2_complete.py (SKIPPED - Phase 3)
    **FR:** FR-4.1, FR-4.2
    **Status:** Phase 6 - NOT IMPLEMENTED
  end note
}

partition "Corrections" {
  :Apply corrections\n(deskew, CLAHE, denoise);
  :Track transform history;
  note right #LightGreen
    **Tests:**
    • test_corrections.py (38 tests)
      - test_deskew_correction
      - test_clahe_enhancement
      - test_sharpening_correction
      - test_denoise_correction
      - test_guardrail_*
    **FR:** FR-6.1 - FR-6.5, FR-3.8
  end note
}

partition "Quality Scoring" {
  :Calculate DQS\n(degradation + complexity);
  :Calculate Pre-OCR Risk;
  note right #LightGreen
    **Tests:**
    • test_dqs_calculator.py (33 tests)
      - test_degradation_score_*
      - test_structural_complexity_*
      - test_pre_ocr_risk_*
      - test_weight_calibration
    • test_pipeline_e2e.py::test_routing_strategies
    **FR:** FR-7.1, FR-7.2
  end note
}

partition "Routing" {
  :Determine OCR strategy\n(fast/advanced/vision);
  note right #LightGreen
    **Tests:**
    • test_dqs_calculator.py::test_pre_ocr_risk_*
    • test_pipeline_e2e.py::test_routing_strategies
    • test_pipeline_e2e.py::test_handoff_json_format
    **FR:** FR-7.2
  end note
}

partition "Output" {
  :DocumentMetadata.json;
  :Corrected page images;
  note right #LightGreen
    **Tests:**
    • test_json_generator.py (12 tests)
    • test_schema.py (25 tests)
    • test_pipeline_e2e.py::TestHandoffValidation
    • test_real_fixtures.py::TestRealFixturesHandoff
    **FR:** FR-1.3
  end note
}

note right
  **Source:**
  - src/.../ingestion/pdf_loader.py
  - src/.../ingestion/pdf_resolution.py
  - src/.../ingestion/pdf_upscaler.py
  - src/.../ingestion/pdf_analyzer.py
  - src/.../ingestion/image_loader.py
  - src/.../classification/pdf_type_classifier.py
  - src/.../detection/text_gate.py
  - src/.../detection/iqa_classical.py
  - src/.../detection/iqa_ml.py
  - src/.../detection/siglip2_multitask.py
  - src/.../correction/corrections.py
  - src/.../metrics/dqs_calculator.py
  - src/.../routing/recommendation_engine.py
  - src/.../output/json_generator.py

  **E2E Tests:**
  - test_pipeline_e2e.py (11 tests)
  - test_real_fixtures.py (14 tests)

  **Integration Tests:**
  - test_pipeline.py
  - test_pdf_upscaling_integration.py

  **Documentation:**
  [[docs/architecture/diagrams/level-2/production-runtime/index.md]]

  **ADR:**
  [[docs/ADRs/0008-multi-stage-pipeline-architecture.md]]
  [[docs/ADRs/0028-resnet-teacher-student-architecture.md]]
  [[docs/ADRs/0036-device-priority-enforcement.md]]
  [[docs/ADRs/0035-modal-gpu-integration.md]]
end note

stop

legend right
  |= Color |= Meaning |
  | <#LightGreen> | Well tested (>80% coverage) |
  | <#Orange> | Partially tested or SKIPPED |
  | <#LightBlue> | Future phase (not implemented) |
  | <#FFCCCC> | LEGACY - superseded content |
end legend

@enduml
