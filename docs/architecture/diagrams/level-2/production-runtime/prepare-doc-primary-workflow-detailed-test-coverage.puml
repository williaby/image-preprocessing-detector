@startuml
title Prepare-Doc – Primary Document Processing Workflow (Detailed with Test Coverage)

skinparam dpi 120
skinparam shadowing false
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor #999999
  FontSize 8
}

start

== INPUT STAGE ==

:Receive raw document\n(PDF / PNG / JPEG / TIFF);
note right #LightGreen
  **Tests:** test_pdf_loader.py, test_image_loader.py
  **FR:** FR-1.1, FR-1.2
end note

== PRE-FLIGHT ANALYSIS ==

partition "DPI Detection" {
  :Extract embedded DPI\n(PyMuPDF for PDFs);
  :Detect effective resolution;
  if (DPI < 300?) then (yes)
    :Flag for upscaling;
  else (no)
    :Mark as adequate;
  endif
}
note right #LightGreen
  **Tests:**
  • test_pdf_resolution.py::test_detect_dpi_*
  • test_pdf_resolution.py::test_page_resolution_*
  **FR:** FR-3.5
end note

partition "DPI Upscaling" {
  if (needs_upscaling?) then (yes)
    :Select algorithm\n(lanczos/bicubic/inter_linear);
    :Upscale to target DPI (300);
    :Validate output quality;
  endif
}
note right #LightGreen
  **Tests:**
  • test_pdf_upscaler.py::test_upscale_*
  • test_pdf_upscaler.py::test_algorithm_*
  • test_pdf_upscaling_integration.py
  **FR:** FR-3.6, FR-6.5
end note

== INGESTION ==

partition "PDF Processing" {
  :Open PDF with PyMuPDF;
  :Iterate pages;
  while (more pages?) is (yes)
    :Render page to pixmap\n(RGB, 300 DPI);
    :Convert to numpy array;
    :Yield PageImage object;
  endwhile (no)
}
note right #LightGreen
  **Tests:**
  • test_pdf_loader.py::test_load_*
  • test_pdf_loader.py::test_multipage_*
  • test_real_fixtures.py::test_*_pdf
  **FR:** FR-1.1, FR-1.2
end note

partition "Image Normalization" {
  :Load image (OpenCV/Pillow);
  :Convert to BGR format;
  :Normalize to 8-bit;
  :Validate dimensions;
}
note right #LightGreen
  **Tests:**
  • test_image_loader.py::test_load_*
  • test_image_loader.py::test_color_*
  **FR:** FR-1.2
end note

== PDF TYPE CLASSIFICATION ==

partition "PDF Classifier" {
  :Analyze text layer presence;
  :Check for embedded fonts;
  :Detect image-only pages;
  if (has text layer?) then (born_digital)
    :pdf_type = BORN_DIGITAL;
  elseif (mixed content?) then (hybrid)
    :pdf_type = HYBRID;
  else (image_only)
    :pdf_type = IMAGE_ONLY;
  endif
}
note right #LightGreen
  **Tests:**
  • test_pdf_type_classifier.py::test_classify_*
  • test_pdf_image_detector.py::test_detect_*
  • test_pdf_text_extractor.py::test_extract_*
  **FR:** FR-2.1
end note

== TEXT GATE ==

partition "Fast Text Detection" {
  :Compute stroke density;
  :Detect connected components;
  :Calculate edge density;
  :Ensemble vote (< 10ms);

  if (text_score > threshold?) then (yes)
    :has_text = True;
  else (no)
    :has_text = False;
  endif
}
note right #LightGreen
  **Tests:**
  • test_text_gate.py::test_stroke_density_*
  • test_text_gate.py::test_connected_components_*
  • test_text_gate.py::test_edge_density_*
  • test_text_gate.py::test_confidence_*
  • test_text_gate.py::test_decision_logic_*
  **FR:** FR-2.4
end note

== IQA DETECTION ==

fork

partition "Classical IQA" {
  :Blur Detection\n(Laplacian variance);
  note right #LightGreen
    **Tests:**
    • test_blur_detector.py (20 tests)
    • test_iqa_classical.py::TestBlurDetection
    **FR:** FR-3.1
  end note

  :Noise Detection\n(Wavelet sigma estimation);
  note right #LightGreen
    **Tests:**
    • test_iqa_classical.py::TestNoiseDetection
    • test_dqs_calculator.py::test_noise_*
    **FR:** FR-3.3
  end note

  :Contrast Detection\n(Histogram spread);
  note right #LightGreen
    **Tests:**
    • test_iqa_classical.py::TestContrastDetection
    **FR:** FR-3.7
  end note

  :Skew Detection\n(Hough transform + Ensemble);
  note right #LightGreen
    **Tests:**
    • test_iqa_classical.py::TestSkewDetection
    **FR:** FR-3.2
  end note

  :Collect all DetectedIssues;
}

fork again

partition "ML IQA (Student Model)" {
  :Load ResNet-18 model;
  :Preprocess image\n(resize, normalize);
  :Forward pass;
  :Extract multi-head predictions;
  :Calculate confidence scores;

  if (uncertainty > threshold?) then (yes)
    :Flag for Teacher inference;
  endif
}
note right #Orange
  **Tests:**
  • test_iqa_ml.py (15 tests)
  • test_iqa_ml_integration.py
  **FR:** FR-2.3
  **Status:** Partial - models not deployed
end note

end fork

partition "Teacher Inference (Selective)" {
  if (flagged_for_teacher?) then (yes)
    :Load ResNet-50 Teacher;
    :Forward pass on flagged pages;
    :Override Student predictions;
  endif
}
note right #Orange
  **Tests:**
  • test_resnet_teacher.py (SKIPPED)
  • test_loss_functions.py (SKIPPED)
  **FR:** FR-2.3
  **Status:** SKIPPED - PyTorch required
end note

== LAYOUT-LITE DETECTION ==

partition "Coarse Layout Analysis" #LightBlue {
  :Detect tables presence;
  :Detect figures/images;
  :Detect handwriting;
  :Detect dense math;
  :Calculate structural_complexity_score;

  :Create PageLayoutSummary;
}
note right #Red
  **Tests:** None
  **FR:** FR-4.1, FR-4.2
  **Status:** NOT IMPLEMENTED (Phase 6)
end note

== CORRECTION ==

partition "Image Corrections" {
  if (skew detected?) then (yes)
    :Apply deskew\n(rotate by -skew_angle);
    note right #LightGreen
      test_corrections.py::test_deskew_*
    end note
  endif

  if (low contrast?) then (yes)
    :Apply CLAHE enhancement;
    note right #LightGreen
      test_corrections.py::test_clahe_*
    end note
  endif

  if (blur detected?) then (yes)
    :Apply sharpening\n(unsharp mask);
    note right #LightGreen
      test_corrections.py::test_sharpening_*
    end note
  endif

  if (noise detected?) then (yes)
    :Apply denoising;
    note right #LightGreen
      test_corrections.py::test_denoise_*
    end note
  endif

  :Track all transforms\nin correction_history;
}
note right #LightGreen
  **Tests:**
  • test_corrections.py (38 tests)
  • test_corrections.py::test_guardrail_*
  **FR:** FR-6.1-FR-6.5, FR-3.8
end note

== QUALITY SCORING ==

partition "DQS Calculation" {
  :Normalize classical IQA scores;
  :Calculate degradation_score\n(weighted sum);
  :Calculate structural_complexity_score;
  :Blend with ML scores;
  :Create DQSMetadata;
}
note right #LightGreen
  **Tests:**
  • test_dqs_calculator.py::test_degradation_*
  • test_dqs_calculator.py::test_structural_*
  • test_dqs_calculator.py::test_normalize_*
  • test_dqs_calculator.py::test_weight_*
  **FR:** FR-7.1
end note

partition "Pre-OCR Risk" {
  :Calculate degradation_risk;
  :Calculate complexity_risk;
  :Apply pdf_type_penalty;
  :Apply handwriting_penalty;
  :total_risk = sum of components;
}
note right #LightGreen
  **Tests:**
  • test_dqs_calculator.py::test_pre_ocr_risk_*
  **FR:** FR-7.1
end note

== ROUTING RECOMMENDATION ==

partition "OCR Strategy Selection" {
  if (dqs > 0.8 AND simple?) then (fast)
    :routing = OCR_FAST;
  elseif (dqs > 0.6?) then (advanced)
    :routing = OCR_ADVANCED;
  elseif (has_tables OR has_figures?) then (structured)
    :routing = VISION_STRUCTURED;
  else (simple)
    :routing = VISION_SIMPLE;
  endif
}
note right #LightGreen
  **Tests:**
  • test_pipeline_e2e.py::test_routing_strategies
  • test_dqs_calculator.py::test_pre_ocr_risk_*
  **FR:** FR-7.2
end note

== OUTPUT ==

partition "JSON Generation" {
  :Create DocumentMetadata;
  :Serialize to JSON;
  :Write DocumentMetadata.json;
}
note right #LightGreen
  **Tests:**
  • test_json_generator.py (12 tests)
  • test_schema.py (25 tests)
  • test_pipeline_e2e.py::TestHandoffValidation
  • test_real_fixtures.py::TestRealFixturesHandoff
  **FR:** FR-1.3
end note

partition "Image Output" {
  :Write corrected page images;
  :Maintain page ordering;
  :Record output paths;
}
note right #LightGreen
  **Tests:**
  • test_pipeline_e2e.py (implicit)
  **FR:** FR-1.3
end note

:Handoff to Unify;

stop

legend right
  |= Color |= Meaning |
  | <#LightGreen> | Well tested |
  | <#Orange> | Partially tested |
  | <#Red> | Not implemented |
  | <#LightBlue> | Future phase |
end legend

@enduml
