@startuml prepare-doc-device-selection-flow
title Prepare-Doc - Device Selection & IQA Execution Flow

skinparam dpi 150
skinparam shadowing false
skinparam activity {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
skinparam note {
  BackgroundColor #F8F8F8
  BorderColor #BBBBBB
}

start

:Start IQA for document batch;

partition "Device Discovery" {
  :Probe local GPU\n(CUDA, memory, utilization);
  :Probe local CPU\n(cores, load, throttling);
  :Check Modal GPU\nquota & network reachability;
}

if (Local GPU available\nand under load threshold?) then (yes)
  :Set primary_device = local_gpu;
else (no)
  if (Local CPU acceptable\n(latency within NFR bounds)?) then (yes)
    :Set primary_device = local_cpu;
  else (no)
    if (Modal GPU allowed\nby config and available?) then (yes)
      :Set primary_device = modal_gpu;
    else (no)
      :Set primary_device = local_cpu\n(last resort, slow path);
      note right
        Even if slow, pipeline
        must still be able to run
        in fully local CPU mode.
      end note
    endif
  endif
endif

partition "MobileNetV4-Conv-S Pre-Correction" {
  :Run MobileNetV4-Conv-S\non primary_device\nfor all pages (~3ms GPU);
  :Extract 3-head predictions:\n- orientation (4-class)\n- skew (regression)\n- resolution quality (0-1);
  :Compute per-head confidence scores;
}

partition "Pre-Correction Application" {
  :Apply orientation correction;
  :Apply deskew from skew prediction;
  :Apply resolution upscaling if needed;
}

partition "SigLIP 2 NAFlex Multi-Task Analysis" {
  :Run SigLIP 2 NAFlex\non primary_device\nfor all pages (~50ms GPU);
  :Extract 22-head predictions\nacross 5 groups:\n(IQA[6], Script[3], Orient+Skew[3],\nHandwriting[5], Page Attrs[5]);
  :Compute per-head confidence scores;
}

:Evaluate per-head confidence\nagainst thresholds;

if (Any heads below\nconfidence threshold?) then (yes)
  partition "Classical Fallback" {
    if (Orientation conf < 0.7?) then (yes)
      :Hough line-based orientation;
    endif
    if (Skew conf < 0.6?) then (yes)
      :Classical Hough skew estimation;
    endif
    if (Resolution conf < 0.5?) then (yes)
      :DPI metadata + char height;
    endif
    if (IQA conf < 0.5?) then (yes)
      :Classical IQA detectors;
    endif
    if (Script conf < 0.6?) then (yes)
      :OpenLID language -> script;
    endif
    if (Handwriting conf < 0.5?) then (yes)
      :Connected component stroke analysis;
    endif
    :Merge classical results\nwith model predictions;
  }
else (no)
  :All heads confident;\nuse model predictions directly;
endif

:Return final multi-task metrics\n(MobileNetV4 + SigLIP 2 + classical fallback)\nto downstream corrections,\nDQS, and routing;

note right
  **Source:**
  - src/.../utils/device_probe.py
  - src/.../orchestration/device_orchestrator.py
  - src/.../orchestration/modal_client.py
  - src/.../workers/celery_app.py
  - src/.../workers/tasks.py
  - src/.../detection/iqa_ml.py
  - src/.../detection/siglip2_multitask.py
  - src/.../detection/iqa_classical.py
  - src/.../detection/orientation_detector.py

  **Documentation:**
  [[docs/architecture/diagrams/level-2/production-runtime/index.md]]
  [[docs/architecture/diagrams/level-3/production-runtime/device-orchestrator.md]]

  **ADR:**
  [[docs/ADRs/0036-device-priority-enforcement.md]]
  [[docs/ADRs/0035-modal-gpu-integration.md]]
  [[docs/ADRs/0020-cpu-first-deployment-strategy.md]]
end note

stop

@enduml
