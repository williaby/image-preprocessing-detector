@startuml
title Project A - Primary Document Processing Workflow (Detailed)

skinparam dpi 150
skinparam shadowing false
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam note {
  BackgroundColor #F8F8F8
  BorderColor #BBBBBB
}

start


' ====== INPUT STAGE ======

:Receive raw document\n(any format);
note right: src/ingestion/


' ====== STAGE 0 — DOCUMENT TYPE ROUTER ======

partition "Stage 0 — Document Type Router" #FFF9C4 {
  :Detect file format\n(extension + MIME type + content signature);

  if (PDF file?) then (yes)
    :Check text layer presence\nand embedded fonts;
    if (text layer present?) then (candidate)
      :Check text validity\n(dictionary hit rate, char entropy);
      if (text quality OK?) then (born_digital)
        :document_class = born_digital;
      else (garbage text)
        :document_class = born_digital_degraded;
        note right
          ~18% of born-digital PDFs have
          corrupt text layers (missing
          ToUnicode maps, mis-encoded fonts).
          Falls back to image pipeline.
        end note
      endif
    elseif (mixed page types?) then (hybrid)
      :document_class = hybrid;
      :Build page_type_map\n(per-page born_digital vs scanned);
    else (image_only)
      :document_class = scanned;
    endif
  elseif (native text format?\nDOCX/XLSX/PPTX/HTML/MD\nLaTeX/CSV/VTT/XML/EPUB) then (yes)
    :document_class = native_text;
  elseif (image file?\nJPG/PNG/TIFF/BMP/WebP) then (yes)
    :document_class = scanned_image;
  elseif (encrypted PDF?) then (yes)
    :document_class = encrypted;
    :Emit halted DocumentMetadata.json;
    note right
      processing_status = "halted"
      failure_reason = "encryption_locked"
      routing_decision = "manual_review"
    end note
    stop
  else (unknown / METS/GBS)
    :document_class = unknown;
  endif

  :Set document_class, file_format,\nrouter_confidence, page_type_map;

  if (native_text OR born_digital?) then (fast path)
    :Pass to Unify directly\n(no image preprocessing);
    note right
      Saves ~55ms GPU per document.
      DOCX, HTML, MD, LaTeX, CSV,
      XML, EPUB, born-digital PDF
    end note
    stop
  else (image / scanned / hybrid\nor born_digital_degraded)
  endif
}
note right
  src/routing/document_type_router.py (planned)
  Promotes classification/pdf_type_classifier.py
  to front of pipeline + adds format detection.
  Target: <20ms CPU
end note


' ====== PRE-FLIGHT ANALYSIS ======

partition "DPI Detection" {
  :Extract embedded DPI\n(PyMuPDF for PDFs);
  :Detect effective resolution;
  if (DPI < 300?) then (yes)
    :Flag for upscaling;
  else (no)
    :Mark as adequate;
  endif
}
note right: src/ingestion/pdf_resolution.py

partition "DPI Upscaling" {
  if (needs_upscaling?) then (yes)
    :Select algorithm\n(lanczos/bicubic/inter_linear);
    :Upscale to target DPI (300);
    :Validate output quality;
  endif
}
note right: src/ingestion/pdf_upscaler.py


' ====== INGESTION ======

partition "PDF Processing" {
  :Open PDF with PyMuPDF;
  :Iterate pages;
  while (more pages?) is (yes)
    :Render page to pixmap\n(RGB, 300 DPI);
    :Convert to numpy array;
    :Yield PageImage object;
  endwhile (no)
}
note right: src/ingestion/pdf_loader.py

partition "Image Normalization" {
  :Load image (OpenCV/Pillow);
  :Convert to BGR format;
  :Normalize to 8-bit;
  :Validate dimensions;
}
note right: src/ingestion/image_loader.py


' ====== TEXT GATE ======

partition "Fast Text Detection" {
  :Compute stroke density;
  :Detect connected components;
  :Calculate edge density;
  :Ensemble vote (< 10ms);

  if (text_score > threshold?) then (yes)
    :has_text = True;
  else (no)
    :has_text = False;
  endif
}
note right: src/detection/text_gate.py


' ====== IQA DETECTION ======

fork

partition "Classical IQA" {
  :Blur Detection\n(Laplacian variance);
  note right: BlurDetector

  :Noise Detection\n(Wavelet sigma estimation);
  note right: NoiseDetector

  :Contrast Detection\n(Histogram spread);
  note right: ContrastDetector

  :Skew Detection\n(Hough transform + Ensemble);
  note right: SkewDetector

  :Collect all DetectedIssues;
}
note right: src/detection/iqa_classical.py

fork again

partition "MobileNetV4-Conv-S (Pre-Correction)" {
  :Load MobileNetV4-Conv-S model;
  :Preprocess image\n(resize, normalize);
  :Forward pass (~3ms GPU);
  :Extract 3-head predictions\n(orientation, skew, resolution quality);
  :Calculate per-head confidence scores;
}
note right
  src/detection/mobilenetv4_precorrection.py
  (orchestrated via src/detection/stage_gate.py)
end note

end fork

partition "Pre-Correction" {
  :Apply orientation correction\n(from MobileNetV4 prediction);
  :Apply deskew correction\n(from MobileNetV4 skew head);
  :Apply resolution fix\n(if resolution quality low);
}

partition "SigLIP 2 NAFlex (Multi-Task Analysis)" {
  :Load SigLIP 2 NAFlex model\n(88M params, 22 heads);
  :Forward pass (~50ms GPU);
  :Extract predictions across 5 groups:\n- Group 1: IQA (6 heads: blur/noise/contrast/skew/compression + overall)\n- Group 2: Script (3 heads: script_code + has_non_latin + has_rtl)\n- Group 3: Orientation + Skew (3 heads: cls + reg + confidence)\n- Group 4: Handwriting (5 heads: 3 cls + 2 reg)\n- Group 5: Page Attributes (5 heads: capture_cls + shadow/warping/code/resolution_quality);
  :Evaluate per-head confidence;

  if (any head confidence\nbelow threshold?) then (yes)
    :Classical fallback for low-confidence heads;
    note right
      6 fallback rules:
      - Orientation < 0.7 -> Hough lines
      - Skew < 0.6 -> Hough skew
      - Resolution < 0.5 -> DPI + char height
      - IQA < 0.5 -> Classical detectors
      - Script < 0.6 -> OpenLID mapping
      - Handwriting < 0.5 -> Stroke analysis
    end note
  endif
}
note right: src/detection/siglip2_multitask.py


' ====== LAYOUT-LITE DETECTION ======

partition "Coarse Layout Analysis" #LightBlue {
  :Detect tables presence;
  :Detect figures/images;
  :Detect handwriting;
  :Detect dense math;
  :Calculate structural_complexity_score;

  :Create PageLayoutSummary\n(layout_type, attributes);
}
note right
  Phase 6 feature
  src/detection/layout_lite.py
end note


' ====== CORRECTION ======

partition "Image Corrections" {
  if (skew detected?) then (yes)
    :Apply deskew\n(rotate by -skew_angle);
  endif

  if (low contrast?) then (yes)
    :Apply CLAHE enhancement;
  endif

  if (blur detected?) then (yes)
    :Apply sharpening\n(unsharp mask);
  endif

  if (noise detected?) then (yes)
    :Apply denoising\n(non-local means);
  endif

  if (border detected?) then (yes)
    :Apply border removal\n(Otsu + morphology;\nretain ≥70% area);
  endif

  if (perspective distortion?) then (yes)
    :Apply perspective correction\n(Canny + quad + homography;\nblocked if warping_score > 0.75);
  endif

  :Track all transforms\nin correction_history;
}
note right
  src/correction/corrections.py
  src/correction/border_removal.py
  src/correction/perspective_correction.py
end note


' ====== QUALITY SCORING ======

partition "DQS Calculation" {
  :Normalize classical IQA scores\n(0-1 range);

  :Calculate degradation_score\nweighted sum of:\n- blur (0.30)\n- noise (0.25)\n- contrast (0.20)\n- illumination (0.15)\n- artifacts (0.10);

  :Calculate structural_complexity_score\nfrom layout-lite analysis;

  :Blend with ML scores\n(ml_blend_ratio = 0.30);

  :Create DQSMetadata;
}
note right: src/metrics/dqs_calculator.py

partition "Pre-OCR Risk" {
  :Calculate pre_ocr_risk using enhanced formula:\n  0.30 * degradation_score\n+ 0.20 * complexity_score\n+ 0.15 * (1 if image_only else 0)\n+ 0.10 * handwriting_penalty\n     (0 NONE, 0.3 MODERATE, 0.6 SUBSTANTIAL, 1.0 DOMINANT)\n+ 0.10 * script_difficulty\n     (0 Latin, 0.3 CJK, 0.5 Arabic, 0.8 Tibetan)\n+ 0.10 * degradation_artifact\n     (shadow_score + warping_score combined)\n+ 0.05 * (1 - legibility_score);
  note right
    Script and handwriting components
    require SigLIP 2 G2/G4 outputs.
    Falls back to 0.0 when model
    not yet deployed.
  end note
}


' ====== ROUTING RECOMMENDATION ======

partition "OCR Strategy Selection" {
  if (dqs > 0.8 AND\nnot has_tables AND\npdf_type = born_digital?) then (fast)
    :routing = OCR_FAST;
  elseif (dqs > 0.6 AND\nnot has_handwriting?) then (advanced)
    :routing = OCR_ADVANCED;
  elseif (has_tables OR\nhas_figures?) then (structured)
    :routing = VISION_STRUCTURED;
  else (simple)
    :routing = VISION_SIMPLE;
  endif
  :Map to Docling CLI params\n(6 rules: text_layer_quality,\nscript-aware, VLM, table_mode,\nenrichments, PSM);
}
note right
  src/routing/recommendation_engine.py
  src/routing/docling_router.py
end note


' ====== OUTPUT ======

partition "JSON Generation" {
  :Create DocumentMetadata\nwith all fields:
  - document_id
  - file_name
  - source_mime
  - num_pages
  - document_class (Stage 0)
  - file_format (Stage 0)
  - router_confidence (Stage 0)
  - page_type_map (Stage 0, hybrid PDFs)
  - pdf_type
  - dqs
  - pre_ocr_risk
  - ocr_routing_recommendation
  - page_layout_summary
  - pages (with detected_issues)
  - processing_version;

  :Serialize to JSON\n(Pydantic model_dump_json);
  :Write DocumentMetadata.json;
}
note right: src/output/json_generator.py

partition "Image Output" {
  :Write corrected page images\nto output directory;
  :Maintain page ordering;
  :Record output paths;
}

:Handoff to Project B\n(OCR Orchestration);

stop

@enduml
