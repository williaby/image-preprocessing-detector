@startuml automated-data-labeling-pipeline
!theme plain
title Automated Data Labeling Pipeline (V2 - Post-Refactoring)

skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle

' Color definitions
skinparam component {
    BackgroundColor<<immutable>> LightBlue
    BackgroundColor<<enrichment>> LightGreen
    BackgroundColor<<training>> LightYellow
    BackgroundColor<<output>> LightGray
    BackgroundColor<<external>> LightPink
    BackgroundColor<<workflow>> Lavender
    BackgroundColor<<monitoring>> Wheat
}

package "Data Sources (E: Drive)" as sources {
    database "01_base_data/" as base_data <<external>> {
        collections degraded
        collections documents
        collections forms
        collections tables
        collections handwriting
        collections formulas
        collections educational
    }

    database "02_benchmark_only/" as benchmark <<external>> {
        collections "DIQA-5000\n(human MOS)"
        collections "LIVE/CSIQ\n(human DMOS)"
        collections "SmartDoc-QA"
        collections "DIBCO"
    }
}

package "annotation.workflow (Three-Stage Pipeline)" as workflow <<workflow>> {
    component "Pre-flight Checks\n(preflight.py)" as preflight {
        [Disk Space\nValidation]
        [Path\nValidation]
        [Model\nAvailability]
    }

    component "BatchScanner\n(scanner.py)" as scanner {
        [File Discovery\n(glob patterns)]
        [Batch Accumulation\n(configurable size)]
        [Checkpoint-aware\nResume]
    }

    component "CPU Stage\n(ProcessPoolExecutor)" as cpu_stage {
        [Parallel SHA256\nHashing]
        [File Metadata\nExtraction]
    }

    component "Parse Stage\n(Sequential)" as parse_stage {
        [Parser Registry\nLookup]
        [Label Parsing\n(per-dataset)]
    }

    component "GPU Stage\n(Single Thread)" as gpu_stage {
        [Batched YOLO\nInference]
        [Batched SigLIP\nPrediction]
    }

    component "IO Stage\n(Checkpointed)" as io_stage {
        [Parquet Writing\n(partitioned)]
        [JSON Export\n(per-dataset)]
        [Atomic\nCheckpoints]
    }
}

package "annotation.parsers (Layer 1: IMMUTABLE)" as layer1 <<immutable>> {
    component "Parser Registry\n(registry.py)" as registry {
        [Explicit Registration]
        [Protocol-based\nExtensibility]
    }

    component "Dataset Parsers" as parsers {
        [quality/\nDIQA, SmartDoc, OCR]
        [layout/\nDocLayNet, TableBank, PubTabNet]
        [handwriting/\nSignaTR, NIST, MathsHW]
        [multilingual/\nMDIW, CC-OCR, Scripts]
        [document/\nRVL-CDIP, OmniDocBench]
    }

    component "Original Data\n(schemas/immutable.py)" as original {
        [OriginalFileMetadata\nformat, dimensions, DPI]
        [OriginalLabels\ndiqa_mos, live_dmos\ndoclaynet_annotations\ntablebank_annotations]
    }
}

package "annotation.enrichment (Layer 2: ENRICHMENT)" as layer2 <<enrichment>> {
    component "EnrichmentManager\n(manager.py)" as manager {
        [Tier-ordered\nExecution]
        [Provider Fallback\nChain]
        [Dead-letter\nQueue]
    }

    component "Providers\n(providers/)" as providers {
        [YOLOProvider\n(layout detection)]
        [SigLIPProvider\n(quality scores)]
        [Built-in\n(tier 0-1 defaults)]
    }

    component "EnrichmentData\n(schemas/enrichment.py)" as enrichment {
        [quality_overall\nlayout_detections]
        [capture_method\ndomain_level1-3]
        [text_density\nlayout_type]
    }

    component "Versioning" as versioning {
        [EnrichmentVersion\nversion, created_at\ncreated_by, method]
    }
}

package "Layer 3: TRAINING (build_training_labels.py)" as layer3 <<training>> {
    component "Score Normalization" as normalize {
        [MOS/DMOS to 0-1]
        [anchor_score\ncomputation]
        [anchor_source\npriority]
    }

    component "IQA Vector Builder" as iqa_builder {
        [45-dim iqa_vector]
        [iqa_binary\n(thresholded)]
        [DEGRADATION_INDEX]
    }

    component "Element Labels" as element_labels {
        [ElementLabel\nfrom COCO]
        [table_type]
        [formula_complexity]
    }
}

package "annotation.monitoring" as monitoring <<monitoring>> {
    component "Prometheus Metrics\n(metrics.py)" as metrics {
        [Pipeline Stage\nDuration]
        [Batch Processing\nCounters]
        [Error Tracking]
    }

    component "Structured Logging\n(logging.py)" as logging {
        [JSON Events]
        [Stage Progress]
        [Error Context]
    }
}

package "Output Artifacts" as outputs <<output>> {
    file "metadata_registry/\nparquet/dataset_name=X/\npart-0000.parquet" as parquet_out
    file "metadata_registry/\njson/{dataset}/*.json" as json_out
    file "training_labels.parquet" as training_out
    file ".checkpoints/\n{dataset}.json" as checkpoints

    note right of parquet_out
        **V2 Partitioned Storage**
        Hive-style partitioning
        O(1) per-dataset writes
        No read-modify-write
    end note

    note right of training_out
        Training-ready labels:
        - iqa_vector (45-dim)
        - anchor_score
        - element_labels
    end note
}

' Flow connections - Pre-flight
preflight --> scanner : "validate\nbefore scan"
base_data --> scanner
benchmark --> scanner

' Flow connections - Pipeline stages
scanner --> cpu_stage : "batches of\nimage paths"
cpu_stage --> parse_stage : "hashed\nsamples"
parse_stage --> io_stage : "parsed\nsamples"

' Parser integration
registry --> parse_stage
parsers --> registry : "registered\nparsers"
parse_stage --> original : "extract\nlabels"

' Enrichment flow (GPU stage)
parse_stage --> gpu_stage : "parsed\nbatch"
manager --> gpu_stage
providers --> manager : "tier-ordered\nproviders"
gpu_stage --> enrichment : "enrich\nsamples"
enrichment --> versioning : "track\nprovenance"

' Output flow
gpu_stage --> io_stage : "enriched\nbatch"
io_stage --> parquet_out : "partitioned\nby dataset"
io_stage --> json_out : "full detail\nper dataset"
io_stage --> checkpoints : "atomic\ncheckpoint"
versioning --> json_out

' Training flow
parquet_out --> normalize : "read\npartitions"
json_out --> normalize
normalize --> iqa_builder
normalize --> element_labels
iqa_builder --> training_out
element_labels --> training_out

' Monitoring connections
cpu_stage ..> metrics : "stage timing"
parse_stage ..> metrics
gpu_stage ..> metrics
io_stage ..> metrics
scanner ..> logging : "progress\nevents"
gpu_stage ..> logging

' Architecture notes
note bottom of workflow
    **V2 Three-Stage Pipeline**
    CPU Stage: Parallel hashing (ProcessPoolExecutor)
    Parse Stage: Sequential (parser caches)
    GPU Stage: Single thread (CUDA safety)
    IO Stage: Checkpointed writes
end note

note right of layer2
    **Provider Pattern**
    Tier 0: By construction (content flags)
    Tier 1: Existing annotations (COCO, MOS)
    Tier 2: ML inference (YOLO, SigLIP)
    Tier 3: Heuristics (fallback)
end note

@enduml
