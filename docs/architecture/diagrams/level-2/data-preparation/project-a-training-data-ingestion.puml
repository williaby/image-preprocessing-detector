@startuml project-a-training-data-ingestion
title Project A - Training Data Ingestion & Preparation (V2 Architecture)

skinparam dpi 150
skinparam shadowing false
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam note {
  BackgroundColor #F8F8F8
  BorderColor #BBBBBB
}
skinparam partition {
  BackgroundColor<<layer1>> LightBlue
  BackgroundColor<<layer2>> LightGreen
  BackgroundColor<<layer3>> LightYellow
  BackgroundColor<<workflow>> Lavender
}

start

partition "Source Datasets (E: Drive)" {
  :01_base_data/\n- degraded, documents, forms\n- tables, handwriting, formulas;
  :02_benchmark_only/\n- DIQA-5000 (human MOS)\n- LIVE/CSIQ (human DMOS)\n- SmartDoc-QA, DIBCO;
}

partition "Pre-flight Validation (preflight.py)" <<workflow>> {
  :Check disk space\n(min_disk_space_gb);
  :Validate paths\n(required_read_paths,\nrequired_write_paths);
  :Check model availability\n(YOLO, SigLIP);
}

partition "Batch Scanning (scanner.py)" <<workflow>> {
  :Discover files\n(configurable patterns);
  :Accumulate batches\n(batch_size setting);
  :Check resume state\n(checkpoint-aware);
}

partition "Layer 1: IMMUTABLE (parsers/)" <<layer1>> {
  :CPU Stage (parallel)\n- SHA256 full-file hashing\n- PIL metadata extraction;
  :Parse Stage (sequential)\n- Parser registry lookup\n- Dataset-specific parsing;
  :Extract OriginalLabels\n- diqa_mos, live_dmos\n- COCO annotations\n- dataset-specific fields;
  note right
    **38+ Dataset Parsers**
    quality/, layout/,
    handwriting/, multilingual/,
    document/
  end note
}

partition "Layer 2: ENRICHMENT (enrichment/)" <<layer2>> {
  :GPU Stage (single thread)\n- Batched YOLO inference\n- Batched SigLIP prediction;
  :EnrichmentManager\n- Tier-ordered providers\n- Fallback chain\n- Dead-letter queue;
  :Derive EnrichmentData\n- quality_overall\n- layout_detections\n- capture_method\n- domain classification;
  note right
    **Provider Pattern**
    Tier 0: By construction
    Tier 1: Existing annotations
    Tier 2: ML inference
  end note
}

partition "IO Stage (pipeline.py)" <<workflow>> {
  :Write partitioned Parquet\n(dataset_name=X/);
  :Write JSON per-dataset\n(full detail);
  :Atomic checkpointing\n(every N batches);
}

partition "Layer 3: TRAINING (build_training_labels.py)" <<layer3>> {
  :Normalize scores\n- MOS/DMOS to 0-1\n- anchor_score priority;
  :Build IQA vector\n- 45-dim iqa_vector\n- iqa_binary flags\n- DEGRADATION_INDEX;
  :Extract element labels\n- COCO to ElementLabel\n- table_type, formula_complexity;
}

partition "Teacher/Student Ready Sets" {
  :Create teacher training sets\n(ResNet-50, high capacity);
  :Create student training sets\n(ResNet-18, distilled);
  :Persist manifests\n(dataset versions,\nlicenses, splits,\nprovenance metadata);
}

stop

note bottom
  **V2 Three-Stage Pipeline**
  CPU: Parallel hashing (ProcessPoolExecutor)
  Parse: Sequential (parser caches)
  GPU: Single thread (CUDA safety)
  IO: Checkpointed Parquet writes
end note

@enduml
