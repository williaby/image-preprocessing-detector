@startuml diqa-training-phases
!theme plain
skinparam backgroundColor #FEFEFE

title DIQA-5000 Training Phases & Dependencies\nVersion 2.0 | December 2025

' ============================================================================
' PHASE 0: DATA PREPARATION
' ============================================================================
|Phase 0: Data Preparation|
start
:Load DIQA-5000 Dataset
(5000 document images);

:Split Dataset
- Train: 3500 (70%)
- Val: 750 (15%)
- Test: 750 (15%);

fork
  :Generate Layout Masks
  via docling-layout;

  note right
    **LayoutMaskGenerator**
    - 11 DocLayNet classes
    - Cache to disk (~2.5GB)
    - ~200ms per image
  end note

  :Cache Masks to GCS
  gs://image_detection_b/datasets/diqa5000/masks;
fork again
  :Prepare VLM Prompts
  JSON output format;
end fork

' ============================================================================
' PHASE 1: TRACK A TRAINING (PARALLEL)
' ============================================================================
|Phase 1: Track A IQA Training|

fork
  ' ---------- A1: MUSIQ ----------
  :A1: MUSIQ Training
  **Sharpness Specialist**;

  note right
    **Implementation Files:**
    ""src/...labeling/finetuning/""
    - musiq_wrapper.py
    - musiq_loss.py
    - musiq_config.py
    - musiq_dataset.py

    ""modal/""
    - train_musiq_finetuning.py

    ""configs/""
    - musiq_finetuning.yaml

    ""tests/unit/labeling/finetuning/""
    - test_musiq_wrapper.py (14 tests)
    - test_musiq_loss.py (18 tests)
    - test_musiq_config.py (18 tests)
    - test_musiq_dataset.py (17 tests)

    **Status:** Infrastructure complete
    Training not yet executed
  end note

  partition "Phase 1a: Head Warmup (10 epochs)" {
    :Freeze PyIQA MUSIQ backbone;
    :Train MultiTaskHead only
    LR: 1e-3, warmup: 2 epochs
    Loss: [0.2, **0.6**, 0.2];
  }

  partition "Phase 1b: Fine-tune (20 epochs)" {
    :Unfreeze backbone;
    :LR: 1e-5 (backbone), 1e-4 (head)
    warmup: 3 epochs + cosine decay;
    :Augmentation:
    - HorizontalFlip (p=0.5)
    - Rotate +/-5° (p=0.3)
    - ColorJitter (p=0.3);
  }

  :Select checkpoint
  Weighted(SRCC_sharpness, ECE)
  Preset: balanced;

fork again
  ' ---------- A2: QualiCLIP ----------
  :A2: QualiCLIP Training
  **Color Specialist**;

  note right
    **Status:** Not yet implemented
    Planned files:
    - qualiclip_wrapper.py
    - qualiclip_config.py
  end note

  partition "Phase 1a: Head Warmup (10 epochs)" {
    :Freeze CLIP ViT-B/32;
    :Train MultiTaskHead only
    LR: 1e-3
    Loss: [0.2, 0.2, **0.6**];
  }

  partition "Phase 1b: Fine-tune (20 epochs)" {
    :Unfreeze encoder;
    :LR: 1e-6 (encoder), 1e-4 (head);
  }

  :Select checkpoint
  Weighted(SRCC_color, ECE)
  Preset: balanced;

fork again
  ' ---------- A3: DocIQ-Replica ----------
  :A3: DocIQ-Replica Training
  **Overall Generalist**;

  note right
    **Status:** Not yet implemented
    Planned files:
    - dociq_wrapper.py
    - dociq_config.py

    **Paper-Aligned Config**
    - Input: 1600x1600
    - Layout masks: 11-class
    - Total: 60 epochs
    - GPU: A100-80GB
  end note

  partition "Phase 1a: Head Warmup (15 epochs)" {
    :Freeze ResNet-50 backbone;
    :Train LayoutFusionDownsampler
    + MultiTaskHead;
    :LR: 1e-3 with warmup (5 epochs)
    + cosine decay
    Loss: [**0.34**, **0.33**, **0.33**];
  }

  partition "Phase 1b: Full Fine-tune (45 epochs)" {
    :Unfreeze entire backbone;
    :LR: 1e-5 (backbone), 1e-4 (head)
    with cosine annealing;
    :Augmentation:
    - horizontal flip
    - rotation (+/-5 deg)
    - mild color jitter;
  }

  :Select checkpoint
  Weighted(SRCC_mean, ECE)
  Preset: balanced;
end fork

' ============================================================================
' PHASE 2: TRACK B TRAINING (PARALLEL)
' ============================================================================
|Phase 2: Track B VLM Training|

fork
  ' ---------- Qwen3-VL-8B ----------
  :Qwen3-VL-8B LoRA Training
  **Balanced Generalist**;

  note right
    **Status:** Not yet implemented
    Planned files:
    - qwen_vlm_wrapper.py
    - qwen_vlm_config.py
  end note

  :Configure LoRA
  r=16, alpha=32
  targets: q/k/v/o_proj;

  :Train 3 epochs
  Batch: 4 (grad_accum=8)
  LR: 2e-4
  Loss: [**0.34**, **0.33**, **0.33**];

  :Select checkpoint
  Weighted(SRCC_mean, ECE)
  Preset: balanced;

fork again
  ' ---------- InternVL3-8B ----------
  :InternVL3-8B LoRA Training
  **Overall Specialist**;

  note right
    **Status:** Not yet implemented
    Planned files:
    - internvl_wrapper.py
    - internvl_config.py
  end note

  :Configure LoRA
  r=16, alpha=32
  targets: q/k/v/o_proj;

  :Train 3 epochs
  Batch: 4 (grad_accum=8)
  LR: 2e-4
  Loss: [**0.6**, 0.2, 0.2];

  :Select checkpoint
  Weighted(SRCC_overall, ECE)
  Preset: balanced;
end fork

' ============================================================================
' PHASE 3: STACKER TRAINING
' ============================================================================
|Phase 3: Ensemble Stacker|

:Collect validation predictions
from all 5 models;

:Compute within-dimension variances
for uncertainty signals;

partition "Train HierarchicalStacker" {
  :Train stacker (100 epochs)
  LR: 1e-3
  Batch: 256
  Calibration weight: 0.5;

  :Early stopping (patience=10)
  on validation loss;
}

partition "Temperature Scaling" {
  :Fit per-dimension temperatures
  (20 epochs, LR: 0.01);
}

' ============================================================================
' PHASE 4: VALIDATION
' ============================================================================
|Phase 4: Validation|

:Run DIQA-5000 test set benchmark;

:Compute metrics with bootstrap CIs;

if (SRCC > 0.94 AND\nECE < 0.08 AND\nCI Width < 0.03?) then (yes)
  :Validation PASSED;
else (no)
  :Identify weak models;

  if (Ensemble weak?) then (yes)
    :Retrain stacker with
    adjusted weights;
  else (no)
    :Retrain individual model
    with tuned hyperparams;
  endif

  :Re-run validation;
endif

' ============================================================================
' PHASE 5: DEPLOYMENT
' ============================================================================
|Phase 5: Model Registry & Deployment|

:Upload models to GCS
with versioning;

:Generate MODEL_CARD.md
for each model;

:Register in model registry
with performance metrics;

:Package as Modal app
for batch inference;

stop

