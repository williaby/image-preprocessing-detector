@startuml DIQA Pseudo-Labeling Workflow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title DIQA-5000 Pseudo-Labeling System - Workflow Architecture\nVersion 2.0 | December 2025

' ============================================================================
' LEGEND
' ============================================================================
legend right
  |= Symbol |= Meaning |
  | <#E8F5E9> | Track A: IQA Models (T4/A10G/A100) |
  | <#E3F2FD> | Track B: VLM Models (A100-80GB) |
  | <#FFF3E0> | Preprocessing / Infrastructure |
  | <#F3E5F5> | Ensemble & Stacking |
  | <#FFEBEE> | Validation & Output |
endlegend

' ============================================================================
' INPUT STAGE
' ============================================================================
package "1. Input Stage" as InputStage #FFF3E0 {
  database "DIQA-5000\nDataset" as Dataset
  component "Image Loader\n(RGB, Normalization)" as ImageLoader

  Dataset --> ImageLoader : Raw images
}

' ============================================================================
' PREPROCESSING - LAYOUT MASK GENERATION
' ============================================================================
package "2. Layout Mask Generation" as LayoutStage #FFF3E0 {
  component "DocLayout-YOLO\n(DocStructBench)" as DocLayoutYOLO
  storage "Mask Cache\n(~2.5GB for 5000 imgs)" as MaskCache

  note right of DocLayoutYOLO
    11 Classes:
    - Caption, Footnote, Formula
    - List-Item, Page-Footer, Page-Header
    - Picture, Section-Header, Table
    - Text, Title
  end note

  ImageLoader --> DocLayoutYOLO : 1600x1600 images
  DocLayoutYOLO --> MaskCache : [11, 1600, 1600] masks
}

' ============================================================================
' TRACK A: IQA MODELS
' ============================================================================
package "3. Track A: IQA Models" as TrackA #E8F5E9 {

  package "Sub-Track A1: MUSIQ" as A1 #E8F5E9 {
    component "MUSIQ Backbone\n(ViT-B/16, 384-dim)" as MUSIQBackbone
    component "MultiTaskHead\n(384 -> 256 -> 3)" as MUSIQHead

    note bottom of A1
      **Role**: Sharpness Specialist
      **Loss Weights**: [0.2, **0.6**, 0.2]
      **Epochs**: 30 (2-phase)
      **GPU**: T4/A10G
      **Checkpoint**: Weighted(SRCC_sharpness, ECE)
    end note
  }

  package "Sub-Track A2: QualiCLIP" as A2 #E8F5E9 {
    component "CLIP ViT-B/32\n(512-dim)" as CLIPBackbone
    component "MultiTaskHead\n(512 -> 256 -> 3)" as CLIPHead

    note bottom of A2
      **Role**: Color Specialist
      **Loss Weights**: [0.2, 0.2, **0.6**]
      **Epochs**: 30 (2-phase)
      **GPU**: T4/A10G
      **Checkpoint**: Weighted(SRCC_color, ECE)
    end note
  }

  package "Sub-Track A3: DocIQ-Replica" as A3 #E8F5E9 {
    component "Layout Fusion\nDownsampler" as LayoutFusion
    component "ResNet-50\n(2048-dim)" as ResNetBackbone
    component "MultiTaskHead\n(2048 -> 512 -> 3)" as DocIQHead

    note bottom of A3
      **Role**: Generalist Anchor
      **Input**: 1600x1600 + Layout Masks
      **Loss Weights**: [**0.34**, **0.33**, **0.33**]
      **Epochs**: 60 (2-phase, paper-aligned)
      **GPU**: A100-80GB
      **Checkpoint**: Weighted(SRCC_mean, ECE)
    end note

    LayoutFusion --> ResNetBackbone : [B, 3, 400, 400]
    ResNetBackbone --> DocIQHead
  }

  MUSIQBackbone --> MUSIQHead
  CLIPBackbone --> CLIPHead
}

' ============================================================================
' TRACK B: VLM MODELS
' ============================================================================
package "4. Track B: VLM Models" as TrackB #E3F2FD {

  package "Qwen3-VL-8B" as QwenPkg #E3F2FD {
    component "Qwen3-VL-8B\n(FP16, LoRA r=16)" as Qwen

    note bottom of QwenPkg
      **Role**: Generalist Anchor
      **Loss Weights**: [**0.34**, **0.33**, **0.33**]
      **Epochs**: 3 (LoRA)
      **GPU**: A100-80GB
      **Checkpoint**: Weighted(SRCC_mean, ECE)
    end note
  }

  package "InternVL3-8B" as InternPkg #E3F2FD {
    component "InternVL3-8B\n(FP16, LoRA r=16)" as InternVL

    note bottom of InternPkg
      **Role**: Overall Specialist
      **Loss Weights**: [**0.6**, 0.2, 0.2]
      **Epochs**: 3 (LoRA)
      **GPU**: A100-80GB
      **Checkpoint**: Weighted(SRCC_overall, ECE)
    end note
  }
}

' ============================================================================
' CONNECTIONS TO TRACKS
' ============================================================================
ImageLoader --> MUSIQBackbone : Variable size
ImageLoader --> CLIPBackbone : 224x224
ImageLoader --> LayoutFusion : 1600x1600
MaskCache --> LayoutFusion : Layout masks
ImageLoader --> Qwen : + Prompt
ImageLoader --> InternVL : + Prompt

' ============================================================================
' PREDICTION COLLECTION
' ============================================================================
package "5. Prediction Collection" as PredCollection #F3E5F5 {
  component "Collect Predictions\n[5 models x 3 dims]" as Collector

  MUSIQHead --> Collector : {overall, sharpness, color}
  CLIPHead --> Collector : {overall, sharpness, color}
  DocIQHead --> Collector : {overall, sharpness, color}
  Qwen --> Collector : {overall, sharpness, color}
  InternVL --> Collector : {overall, sharpness, color}
}

' ============================================================================
' UNCERTAINTY & STACKING
' ============================================================================
package "6. Uncertainty-Aware Stacking" as StackingStage #F3E5F5 {

  component "Within-Dimension\nVariance Calculator" as VarianceCalc

  note right of VarianceCalc
    **Specialties by Dimension:**
    - Overall: [Qwen, DocIQ, InternVL]
    - Sharpness: [Qwen, DocIQ, MUSIQ]
    - Color: [Qwen, DocIQ, QualiCLIP]

    Uncertainty = var(specialist_preds)
  end note

  component "HierarchicalStacker\n(n_models=5, hidden=32)" as Stacker
  component "Temperature Scaler\n(per-dimension)" as TempScaler

  Collector --> VarianceCalc
  Collector --> Stacker
  VarianceCalc --> Stacker : Uncertainty signals
  Stacker --> TempScaler : pred + var
}

' ============================================================================
' CHECKPOINT SELECTION (TRAINING)
' ============================================================================
package "7. Checkpoint Selection" as CheckpointStage #FFF3E0 {
  component "Weighted Scoring\n(SRCC + ECE)" as WeightedScore

  note right of WeightedScore
    **Balanced Preset (Default):**
    - SRCC Weight: 70%
    - ECE Weight: 30%
    - SRCC Band: +/- 0.02

    **Presets Available:**
    - srcc_dominant (80/20, +/-0.015)
    - balanced (70/30, +/-0.02)
    - calibration_aware (60/40, +/-0.025)
  end note
}

' ============================================================================
' VALIDATION
' ============================================================================
package "8. Validation & Metrics" as ValidationStage #FFEBEE {
  component "DIQA-5000\nBenchmark" as Benchmark
  component "Bootstrap CI\n(n=1000)" as Bootstrap
  component "ECE Calculator\n(10 bins)" as ECECalc

  note bottom of ValidationStage
    **Targets:**
    - SRCC > 0.94 (ensemble)
    - ECE < 0.08
    - CI Width < 0.03
  end note

  TempScaler --> Benchmark
  Benchmark --> Bootstrap
  Benchmark --> ECECalc
}

' ============================================================================
' OUTPUT
' ============================================================================
package "9. Output Generation" as OutputStage #FFEBEE {
  component "DIQAPseudoLabel\nGenerator" as LabelGen

  artifact "pseudo_labels.json" as OutputJSON
  artifact "uncertainty_report.csv" as UncertaintyReport

  note right of LabelGen
    **Output Fields:**
    - overall/sharpness/color scores
    - overall/sharpness/color uncertainties
    - model_predictions (all 5)
    - within_dim_variances
    - high_uncertainty flag
    - model_disagreement flag
  end note

  TempScaler --> LabelGen
  LabelGen --> OutputJSON
  LabelGen --> UncertaintyReport
}

' ============================================================================
' MODEL STORAGE
' ============================================================================
package "10. Model Registry" as RegistryStage #FFF3E0 {
  database "GCS: gs://image_detection_b/\nmodels/diqa/" as GCS

  folder "track_a_iqa/" as TrackAStorage {
    file "dociq_replica/v1.0.0/" as DocIQStorage
    file "musiq/v1.0.0/" as MUSIQStorage
    file "qualiclip/v1.0.0/" as QualiCLIPStorage
  }

  folder "track_b_vlm/" as TrackBStorage {
    file "qwen3_vl_8b/v1.0.0/" as QwenStorage
    file "internvl3_8b/v1.0.0/" as InternStorage
  }

  folder "stacker/v1.0.0/" as StackerStorage

  GCS --> TrackAStorage
  GCS --> TrackBStorage
  GCS --> StackerStorage
}

' ============================================================================
' TRAINING WORKFLOW (SEPARATE SWIMLANE)
' ============================================================================
package "Training Workflows" as TrainingWorkflows {

  rectangle "Track A Training\n(T4/A10G/A100)" as TrackATraining #E8F5E9 {
    (A1: MUSIQ Fine-tune\n30 epochs, 4-6 hrs) as TrainA1
    (A2: QualiCLIP Fine-tune\n30 epochs, 4-6 hrs) as TrainA2
    (A3: DocIQ-Replica\n60 epochs, 12-18 hrs) as TrainA3
  }

  rectangle "Track B Training\n(A100-80GB)" as TrackBTraining #E3F2FD {
    (Qwen3-VL-8B LoRA\n3 epochs, 6-8 hrs) as TrainQwen
    (InternVL3-8B LoRA\n3 epochs, 6-8 hrs) as TrainIntern
  }

  rectangle "Stacker Training" as StackerTraining #F3E5F5 {
    (HierarchicalStacker\n100 epochs) as TrainStacker
    (Temperature Scaling\n20 epochs) as TrainTemp
  }

  TrainA1 --> WeightedScore
  TrainA2 --> WeightedScore
  TrainA3 --> WeightedScore
  TrainQwen --> WeightedScore
  TrainIntern --> WeightedScore

  WeightedScore --> TrainStacker : Best checkpoints
  TrainStacker --> TrainTemp
}

@enduml
