@startuml diqa-inference-pipeline
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

title DIQA Pseudo-Labeling Inference Pipeline\nBatch Processing Flow

' ============================================================================
' COMPONENT DIAGRAM: Inference Architecture
' ============================================================================

package "Modal Serverless Infrastructure" as Modal {

  package "GPU Pool" as GPUPool {
    node "A10G Instances\n(Track A light)" as A10G {
      component "MUSIQ\n(27M params)" as MUSIQ_Inf
      component "QualiCLIP\n(150M params)" as QualiCLIP_Inf
    }

    node "A100-80GB Instances\n(Track A heavy + Track B)" as A100 {
      component "DocIQ-Replica\n(25M + masks)" as DocIQ_Inf
      component "Qwen3-VL-8B\n(8B params)" as Qwen_Inf
      component "InternVL3-8B\n(8B params)" as InternVL_Inf
    }
  }

  package "Orchestration" as Orchestration {
    component "Batch Scheduler" as Scheduler
    component "Result Aggregator" as Aggregator
    queue "Job Queue" as JobQueue
  }
}

' ============================================================================
' INPUT/OUTPUT
' ============================================================================

database "Input Images\n(GCS Bucket)" as InputBucket
database "Layout Mask Cache\n(GCS)" as MaskCache
database "Output Labels\n(GCS)" as OutputBucket

' ============================================================================
' CONNECTIONS
' ============================================================================

InputBucket --> Scheduler : Batch of images
Scheduler --> JobQueue : Distribute jobs

JobQueue --> MUSIQ_Inf : Image batch
JobQueue --> QualiCLIP_Inf : Image batch
JobQueue --> DocIQ_Inf : Image + mask batch
JobQueue --> Qwen_Inf : Image + prompt
JobQueue --> InternVL_Inf : Image + prompt

MaskCache --> DocIQ_Inf : Pre-computed masks

MUSIQ_Inf --> Aggregator : predictions
QualiCLIP_Inf --> Aggregator : predictions
DocIQ_Inf --> Aggregator : predictions
Qwen_Inf --> Aggregator : predictions
InternVL_Inf --> Aggregator : predictions

Aggregator --> OutputBucket : Pseudo-labels JSON

note right
  **Source:**
  - src/.../labeling/arena/runner.py
  - src/.../labeling/arena/inference/modal.py
  - src/.../labeling/arena/inference/api.py
  - src/.../labeling/arena/schemas.py

  **Scripts:**
  - modal/train_siglip2_multitask.py

  **Documentation:**
  [[docs/architecture/diagrams/level-2/pseudo-labeling/index.md]]
  [[docs/planning/PSEUDO_LABELING_PROJECT_PLAN.md]]
  [[docs/planning/UNIFIED_LABELING_STRATEGY.md]]

  **ADR:**
  [[docs/ADRs/0028-resnet-teacher-student-architecture.md]]
end note


