@startuml rag-pipeline-overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam componentStyle rectangle

' Layout controls
skinparam ranksep 140
skinparam nodesep 90

top to bottom direction

title Foundry RAG Pipeline - Multi-Track Architecture\nLevel 0: Pipeline Context (Cloud Workflows Orchestrated)
footer Foundry Pipeline Overview | v7.0 | February 2026

' ============================================================================
' ORCHESTRATION LAYER: CLOUD WORKFLOWS
' ============================================================================

cloud "Google Cloud Workflows\n<size:10>Orchestrator | trace_id propagation</size>" as Orchestrator #E3F2FD

' ============================================================================
' DATA STORE: GCS (positioned to side)
' ============================================================================

storage "GCS: gs://rag-pipeline-{env}/{trace_id}/\n<size:10>Canonical artifact store</size>" as GCS #FFF3E0

' ============================================================================
' ROW 1: INGEST — File Reception & Service Routing
' ============================================================================

package "Ingest (foundry-ingest)\n<size:10><color:green>■ Active</color></size>\n<size:10>POST /process | GET /status | 1000+ files/hr</size>" as Ingest #FFEBEE {
  component "File Reception\n<size:9>Accepts any file type · trace_id assignment\nStores to GCS raw</size>" as FileRecv
  component "Audio / Video\n<size:9>WAV · MP3 · MP4\n→ Prepare-Audio directly</size>" as AudioTrack
  component "Native Text · Image · PDF\n<size:9>DOCX · HTML · JPG · PNG · PDF (all variants)\n→ Prepare-Doc (enters at Stage 0)</size>" as DocTrack
}

' ============================================================================
' ROW 2: TWO PROCESSING PATHS
' ============================================================================

together {

  rectangle "Prepare-Doc (foundry-prepare-doc)\n<size:10><color:green>■ Active</color></size>\n<size:10>All non-audio documents · ~55ms GPU total</size>" as PrepareDoc #E8F5E9 {
    component "Stage 0 — Document Type Router\n<size:9>MIME detect · PDF sub-classify · Text-layer validity · <20ms CPU\nnative_text | image_only | born_digital | scanned | hybrid</size>" as Stage0
    component "Pre-Correction Pipeline (Steps 1–4)\n<size:9>Rasterize · PNG · MobileNetV4 ~3ms · Geometric Corrections</size>" as Stage1
    component "Quality Analysis + Corrections (Steps 5–7)\n<size:9>Text Gate · Classical IQA · SigLIP 2 ~50ms · Layout · CLAHE</size>" as Stage2
    component "DQS & Routing Metadata" as DQS
  }

  rectangle "Prepare-Audio (foundry-prepare-audio)\n<size:10><color:green>■ Active</color></size>\n<size:10><1 min per hour of audio</size>" as PrepareAudio #E8F5E9 {
    component "FFmpeg Extraction" as FFmpeg
    component "Deepgram Nova-2" as Deepgram
    component "Diarization" as Diarize
  }

}

' ============================================================================
' ROW 3: UNIFY — OCR & DOM UNIFICATION
' ============================================================================

package "Unify (foundry-unify)\n<size:10><color:gray>○ Not Yet Started</color></size>\n<size:10>Multi-engine OCR | Docling DOM unification</size>" as Unify #E0E0E0 {
  rectangle "OCR Orchestration" as OCRLayer {
    component "Multi-Engine OCR" as OCR
    component "Engine Selection" as EngineSelect
    component "Result Fusion" as ResultFusion
  }
  database "Docling DOM\n(Unified Schema)" as DoclingDOM
}

' ============================================================================
' ROW 4: CHUNK — TRUST & CHUNKING
' ============================================================================

together {
  package "Chunk (foundry-chunk)\n<size:10><color:gray>○ Not Yet Started</color></size>\n<size:10>Identical chunking for all content types</size>" as Chunk #E0E0E0 {
    component "Trust Scoring" as Trust
    component "RAG Chunking" as Chunking
    component "Normalization" as Normalize
  }

  rectangle "Application Embedding\n<size:10><color:gray>● Per-application implementation</color></size>\n<size:10>Must conform to RAGChunkSet contract</size>\n<size:10>See: chunk-embed-contract.md</size>" as AppEmbed #F5F5F5
}

' ============================================================================
' FLOW CONNECTIONS
' ============================================================================

' Orchestration
Ingest -up-> Orchestrator : initiates workflow\n(POST /execute)

' Ingest → two services (Ingest detects audio vs. non-audio)
AudioTrack -down-> PrepareAudio : Audio / Video\n(direct — bypasses Stage 0)
DocTrack -down-> PrepareDoc : Native Text · Image · PDF\n(enters Prepare-Doc at Stage 0)

' Row 2 → Row 3: both paths converge at Unify
PrepareDoc -down-> Unify : gs://.../01-preprocessed/\nDocumentMetadata.json
PrepareAudio -down-> Unify : gs://.../02-transcribed/\nTranscriptMetadata.json

' Row 3 internal: OCR to DOM
OCRLayer -right-> DoclingDOM

' Row 3 → Row 4
DoclingDOM -down-> Chunk : gs://.../03-docling-dom/

' Row 4 → Row 5
Chunk -right-> AppEmbed : gs://.../04-chunks/\nRAGChunkSet + TrustMetrics

' ============================================================================
' LEGEND
' ============================================================================

legend bottom
  |= Color |= Meaning |
  | <#E3F2FD> | Orchestration (Cloud Workflows) |
  | <#FFF3E0> | Data Store (GCS) |
  | <#FFEBEE> | Ingest (Entry Point + audio/doc routing) |
  | <#E8F5E9> | Active Development |
  | <#E0E0E0> | Not Yet Started |
  | <#F5F5F5> | Application-specific (per-app; shared contract) |
endlegend

' Note: Diagram hierarchy and traceability tables are documented in index.md
' ── Level 1 Drill-Down Links ─────────────────────────────────────────────────
' Prepare-Doc:   docs/architecture/diagrams/level-1/index.md
'   ├─ PREPARE_DOC_ARCHITECTURE_OVERVIEW.puml  (8 workstreams)
'   └─ PREPARE_DOC_WORKFLOW_HIERARCHY.puml     (swimlane data flow)
' Prepare-Audio: foundry-prepare-audio repo — docs/architecture/diagrams/level-1/index.md
' Ingest:        foundry-ingest repo — docs/architecture/diagrams/level-1/index.md
' ── Level 2 Drill-Down (via Level 1) ─────────────────────────────────────────
' Stage 0 detail:           docs/architecture/diagrams/level-2/production-runtime/index.md
' PDF sub-classification:   docs/tmp_cleanup/docling_format_routing_analysis.md

@enduml
