@startuml PREPARE_DOC_ARCHITECTURE_OVERVIEW
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam arrowThickness 2
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 40

title Prepare-Doc (Prepare-Doc) - Production-Centric Architecture\n1 Primary Flow + 7 Supporting Workstreams

footer Prepare-Doc | Stage 0 + 8 Workstreams | Last Updated: 2026-02-22

' ============================================================================
' LEGEND
' ============================================================================
legend right
  |<#E8F5E9>  | **Production Runtime** (Primary) |
  |<#E3F2FD>  | Model Training |
  |<#FFF3E0>  | Data Preparation |
  |<#F3E5F5>  | Pseudo-Labeling |
  |<#E0F7FA>  | Labeling Models |
  |<#FFF8E1>  | Arena Benchmarking |
  |<#FFEBEE>  | Monitoring & Drift |
  |<#FCE4EC>  | Synthetic Generation |
endlegend

' ============================================================================
' UPSTREAM INPUT (Top)
' ============================================================================
cloud "RAG Processor\nWeb UI" as UI #DDDDDD {
  card "Document\nSubmission" as DocSubmit
}

' ============================================================================
' PRIMARY PRODUCTION FLOW (CENTER - Vertical Top-to-Bottom)
' ============================================================================
package "WS 1: Production Runtime\n<150ms/page (GPU) | ≥6 pages/sec" #E8F5E9 {
  rectangle "Stage 0:\nDocument Type Router" as Stage0 #FFF9C4 {
    card "Format Detector\n& PDF Sub-Classifier"
    card "Native Text /\nAudio Fast-Path Gate"
  }

  rectangle "Pre-flight &\nIngestion" as Preflight {
    card "DPI Detection\n& Upscaling"
    card "300 DPI\nStandardization"
  }

  rectangle "Classification" as Class {
    card "Text Gate"
  }

  rectangle "Quality\nAnalysis" as QA {
    card "Classical IQA"
    card "ML IQA\n(MobileNetV4\n+ SigLIP 2)"
    card "Layout-Lite"
  }

  rectangle "Correction &\nOutput" as Correction {
    card "Correction\nPipeline"
    card "DQS & Routing"
  }
}

' ============================================================================
' DOWNSTREAM OUTPUT (Bottom)
' ============================================================================
cloud "Downstream\nProjects" as Downstream #DDDDDD {
  card "Unify\n(OCR)" as ProjectB
  card "Chunk\n(Fusion)" as ProjectC
  card "Embed\n(Vector)" as ProjectD
}

' ============================================================================
' SUPPORTING WORKSTREAMS (Left Side)
' ============================================================================

' Model Training Support (Left)
package "WS 2: Model Training\nModal GPU | 12-24hr" #E3F2FD {
  card "Teacher-Student\nTraining" as Train
  card "Model\nRegistry" as Registry
}

' Arena Support (Left)
package "WS 6: Arena\nPLCC > 0.65 required" #FFF8E1 {
  card "Phase 1:\nBase Eval" as Arena1
  card "Phase 2:\nValidation" as Arena2
  card "Phase 3:\nDrift Check" as Arena3
}

' Monitoring Support (Left)
package "WS 7: Monitoring\nAlert: PLCC drop > 5%" #FFEBEE {
  card "Performance\nTracking" as PerfTrack
  card "Drift Detection\n& Harvesting" as DriftHarvest
}

' ============================================================================
' SUPPORTING WORKSTREAMS (Right Side)
' ============================================================================

' Data Preparation Support (Right)
package "WS 3: Data Prep\nOHR-Bench ~18GB" #FFF3E0 {
  card "Dataset\nIngestion" as DataIngest
  card "Cataloging" as DataCatalog
}

' Synthetic Generation Support (Right)
package "WS 8: Synthetic\n70% real + 30% synthetic" #FCE4EC {
  card "Genalog\nDegradation" as Genalog
  card "Auto Ground\nTruth" as GroundTruth
}

' Pseudo-Labeling Support (Right)
package "WS 4: Pseudo-Label\nEnsemble > 0.85 agreement" #F3E5F5 {
  card "Script +\nModel Ensemble" as Ensemble
}

' Labeling Models Support (Right)
package "WS 5: Labeling\nModels" #E0F7FA {
  card "Pretrained IQA\nModels" as LabelModels
}

' ============================================================================
' PRIMARY PRODUCTION FLOW (BOLD ARROWS TOP-TO-BOTTOM)
' ============================================================================
DocSubmit -[#000000,thickness=4]down-> Stage0 : **Any Format**
Stage0 -[#000000,thickness=4]down-> Preflight : **Image / Scanned PDF\n/ Hybrid PDF pages**
Stage0 -[#4CAF50,dashed,thickness=2]right-> Downstream : native text +\nborn-digital PDF\n(fast path)
Preflight -[#000000,thickness=4]down-> Class : **300 DPI Pages**
Class -[#000000,thickness=4]down-> QA : **Routed**
QA -[#000000,thickness=4]down-> Correction : **Analyzed**
Correction -[#000000,thickness=4]down-> Downstream : **DocumentMetadata.json\n+ Corrected Images**

Downstream -down-> ProjectB
ProjectB -down-> ProjectC
ProjectC -down-> ProjectD

' ============================================================================
' SUPPORTING WORKSTREAM CONNECTIONS
' ============================================================================

' Model Deployment: Training → Production (Blue)
Registry -[#0000FF]right-> QA : Deploy\nModels
Train -down-> Registry

' Arena Validation Gates: Arena → Training/Production (Orange)
Arena2 -[#FF6F00]right-> Registry : Graduate
Arena1 -up-> Train : Select\nArchitectures
Arena3 -up-> Train : Validate\nRecovery

' Performance Monitoring: Production → Monitoring (Pink)
QA -[#E91E63]left-> PerfTrack : Predictions\n& Metrics
PerfTrack -down-> DriftHarvest

' Sample Flow: Monitoring → Data → Training (Purple)
DriftHarvest -[#9C27B0]right-> DataIngest : Difficult\nSamples
DataIngest -down-> Genalog : Clean\nImages
Genalog -down-> GroundTruth
GroundTruth -down-> Ensemble : Synthetic\nDataset
Ensemble -[#9C27B0]left-> Train : Labeled\nDataset

' Labeling Models: Support Ensemble (Cyan)
LabelModels -down-> Ensemble : Labeling\nTools
LabelModels -[#00BCD4]up-> Arena1 : Baseline\nBenchmark
DataCatalog -right-> LabelModels : Training\nData

' ============================================================================
' FEEDBACK LOOP (Retraining - Dashed Red)
' ============================================================================
DriftHarvest .[#FF0000,thickness=3].> Train : PLCC drop\n> 10%\n(Trigger Retrain)
Arena3 .[#FF0000,thickness=3].> Registry : Recovery\nValidated\n(Re-Deploy)

' ============================================================================
' CONTEXT NOTES (Minimal)
' ============================================================================
note top of UI
  **UPSTREAM**
  RAG Web UI
end note

note bottom of Downstream
  **DOWNSTREAM**
  Projects B → C → D
end note

@enduml
