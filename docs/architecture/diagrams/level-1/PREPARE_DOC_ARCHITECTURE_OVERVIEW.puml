@startuml PREPARE_DOC_ARCHITECTURE_OVERVIEW
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam arrowThickness 2
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 40

title Prepare-Doc - Production-Centric Architecture\n1 Primary Flow + 7 Supporting Workstreams

footer Prepare-Doc | Stage 0 + 8 Workstreams | Last Updated: 2026-02-22

' ============================================================================
' LEGEND
' ============================================================================
legend right
  |<#E8F5E9>  | **Production Runtime** (Primary) |
  |<#E3F2FD>  | Model Training |
  |<#FFF3E0>  | Data Preparation |
  |<#F3E5F5>  | Pseudo-Labeling |
  |<#E0F7FA>  | Labeling Models |
  |<#FFF8E1>  | Arena Benchmarking |
  |<#FFEBEE>  | Monitoring & Drift |
  |<#FCE4EC>  | Synthetic Generation |
endlegend

' ============================================================================
' UPSTREAM INPUT (Top)
' ============================================================================
cloud "RAG Processor\nWeb UI" as UI #DDDDDD {
  card "Document\nSubmission" as DocSubmit
}

' ============================================================================
' PRIMARY PRODUCTION FLOW (CENTER - Vertical Top-to-Bottom)
' ============================================================================
package "WS 1: Production Runtime\n<150ms/page (GPU) | ≥6 pages/sec\nLevel 2 [production-runtime/]: primary-workflow-detailed (primary)\n  + device-selection-flow · worker-architecture\n  + primary-workflow-test-coverage · primary-workflow-detailed-test-coverage" #E8F5E9 {
  rectangle "Stage 0:\nDocument Type Router" as Stage0 #FFF9C4 {
    card "Format Detector\n& PDF Sub-Classifier"
    card "Text Layer\nQuality Validation"
  }

  rectangle "Pre-Correction\nPipeline" as Preflight {
    card "Step 1: Rasterization\n(300 DPI fallback)"
    card "Step 1b: Lossless\nConversion (PNG)"
    card "Step 2: MobileNetV4-Conv-S\n(3 heads: orient · skew · res)"
    card "Step 3: Geometric Corrections\n& Border Removal"
    card "Step 4: Adaptive Resolution\n(char-height-aware)"
  }

  rectangle "Text Gate\n& Early Exit" as Class {
    card "Text Gate (<10ms)\non corrected image"
    card "Blank Page\nEarly Exit"
  }

  rectangle "Quality\nAnalysis" as QA {
    card "Classical IQA\n(8 detectors)"
    card "SigLIP 2 NAFlex\n(19 heads ~50ms)"
    card "Layout Analysis\n(Docling, conditional)"
  }

  rectangle "Quality Corrections\n& Output" as Correction {
    card "CLAHE · Sharpening\n· Denoising"
    card "DQS & Routing\nMetadata"
  }
}

' ============================================================================
' DOWNSTREAM OUTPUT (Bottom)
' ============================================================================
cloud "Downstream\nServices" as Downstream #DDDDDD {
  card "Unify\n(OCR)" as ProjectB
  card "Chunk\n(Fusion)" as ProjectC
  card "Embed\n(Vector)" as ProjectD
}

' ============================================================================
' SUPPORTING WORKSTREAMS (Left Side)
' ============================================================================

' Model Training Support (Left)
package "WS 2: Model Training\nModal GPU | 12-24hr\nLevel 2 [model-training/]: training-workflow-high-level (primary)\n  + training-infrastructure · siglip2-phased-training\n  + stream-4d-mobilenetv4-integration · wild-conditions-remediation\n  + training-workflow-test-coverage · training-workflow-v2 (legacy)" #E3F2FD {
  card "Teacher-Student\nTraining" as Train
  card "Model\nRegistry" as Registry
}

' Arena Support (Left)
package "WS 6: Arena\nPLCC > 0.65 required\nLevel 2: model-arena/model-arena-architecture.puml" #FFF8E1 {
  card "Phase 1:\nBase Eval" as Arena1
  card "Phase 2:\nValidation" as Arena2
  card "Phase 3:\nDrift Check" as Arena3
}

' Monitoring Support (Left)
package "WS 7: Monitoring\nAlert: PLCC drop > 5%\nLevel 2: monitoring-drift/monitoring-drift-architecture.puml" #FFEBEE {
  card "Performance\nTracking" as PerfTrack
  card "Drift Detection\n& Harvesting" as DriftHarvest
}

' ============================================================================
' SUPPORTING WORKSTREAMS (Right Side)
' ============================================================================

' Data Preparation Support (Right)
package "WS 3: Data Prep\nOHR-Bench ~18GB\nLevel 2 [data-preparation/]: training-data-ingestion (primary)\n  + automated-data-labeling · metadata-schema-architecture\n  + resolution-quality-labeling · skew-orientation-labeling · l2-metadata-enrichment\n  + stream-4c-dataset-preparation · stream-4e-handwriting-dataset\n  + compound-distortion-augmentation" #FFF3E0 {
  card "Dataset\nIngestion" as DataIngest
  card "Cataloging" as DataCatalog
}

' Synthetic Generation Support (Right)
package "WS 8: Synthetic\n70% real + 30% synthetic\nLevel 2: synthetic-generation/synthetic-generation-architecture.puml" #FCE4EC {
  card "Genalog\nDegradation" as Genalog
  card "Auto Ground\nTruth" as GroundTruth
}

' Pseudo-Labeling Support (Right)
package "WS 4: Pseudo-Label\nEnsemble > 0.85 agreement\nLevel 2 [pseudo-labeling/]: diqa-training-phases (primary)\n  + diqa-pseudo-labeling-workflow · diqa-checkpoint-selection\n  + diqa-inference-pipeline · soft-label-pipeline-integration" #F3E5F5 {
  card "Script +\nModel Ensemble" as Ensemble
}

' Labeling Models Support (Right)
package "WS 5: Labeling\nModels\nLevel 2: labeling-benchmarking/domain-classification-pipeline.puml" #E0F7FA {
  card "Pretrained IQA\nModels" as LabelModels
}

' ============================================================================
' PRIMARY PRODUCTION FLOW (BOLD ARROWS TOP-TO-BOTTOM)
' ============================================================================
DocSubmit -[#000000,thickness=4]down-> Stage0 : **Any Format**
Stage0 -[#000000,thickness=4]down-> Preflight : **Image / Scanned PDF\n/ born_digital_degraded\n/ Hybrid PDF pages**
Stage0 -[#4CAF50,dashed,thickness=2]right-> Downstream : native text +\nvalidated born-digital PDF\n(fast path)
Preflight -[#000000,thickness=4]down-> Class : **Corrected\nLossless Images**
Class -[#000000,thickness=4]down-> QA : **Routed\n(non-blank)**
QA -[#000000,thickness=4]down-> Correction : **Analyzed**
Correction -[#000000,thickness=4]down-> Downstream : **DocumentMetadata.json\n+ Corrected Images**

Downstream -down-> ProjectB
ProjectB -down-> ProjectC
ProjectC -down-> ProjectD

' ============================================================================
' SUPPORTING WORKSTREAM CONNECTIONS
' ============================================================================

' Model Deployment: Training → Production (Blue)
Registry -[#0000FF]right-> QA : Deploy\nModels
Train -down-> Registry

' Arena Validation Gates: Arena → Training/Production (Orange)
Arena2 -[#FF6F00]right-> Registry : Graduate
Arena1 -up-> Train : Select\nArchitectures
Arena3 -up-> Train : Validate\nRecovery

' Performance Monitoring: Production → Monitoring (Pink)
QA -[#E91E63]left-> PerfTrack : Predictions\n& Metrics
PerfTrack -down-> DriftHarvest

' Sample Flow: Monitoring → Data → Training (Purple)
DriftHarvest -[#9C27B0]right-> DataIngest : Difficult\nSamples
DataIngest -down-> Genalog : Clean\nImages
Genalog -down-> GroundTruth
GroundTruth -down-> Ensemble : Synthetic\nDataset
Ensemble -[#9C27B0]left-> Train : Labeled\nDataset

' Labeling Models: Support Ensemble (Cyan)
LabelModels -down-> Ensemble : Labeling\nTools
LabelModels -[#00BCD4]up-> Arena1 : Baseline\nBenchmark
DataCatalog -right-> LabelModels : Training\nData

' ============================================================================
' FEEDBACK LOOP (Retraining - Dashed Red)
' ============================================================================
DriftHarvest .[#FF0000,thickness=3].> Train : PLCC drop\n> 10%\n(Trigger Retrain)
Arena3 .[#FF0000,thickness=3].> Registry : Recovery\nValidated\n(Re-Deploy)

' ============================================================================
' CONTEXT NOTES
' ============================================================================
note top of UI
  **UPSTREAM**
  RAG Web UI
end note

note bottom of Downstream
  **DOWNSTREAM**
  Services B -> C -> D
end note

note right of Stage0
  **born_digital validation:**
  Word recognition rate +
  character entropy +
  text/image layer overlap
  Fail -> born_digital_degraded
  -> image pipeline
end note

' ── Level 0 Context ──────────────────────────────────────────────────────────
' Parent: docs/architecture/diagrams/level-0/index.md
'   └─ rag-pipeline-overview.puml  (multi-service RAG pipeline context)

@enduml
