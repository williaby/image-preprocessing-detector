@startuml Project_A_Architecture_Overview
!theme plain
skinparam backgroundColor #FEFEFE
skinparam packageStyle rectangle
skinparam componentStyle rectangle

title Project A - Complete System Architecture\nPreprocessing, IQA & Routing Gateway
footer Document Image Quality Assessment Pipeline | v2.0 | December 2025

' ============================================================================
' LEGEND
' ============================================================================
legend right
  |= Color |= Meaning |
  | <#E8F5E9> | Production Runtime |
  | <#E3F2FD> | Model Training |
  | <#FFF3E0> | Data Preparation |
  | <#F3E5F5> | Pseudo-Labeling |
  | <#FFEBEE> | External Systems |
  | <#E0E0E0> | Not Yet Started |
endlegend

' ============================================================================
' EXTERNAL CONTEXT - RAG PIPELINE ECOSYSTEM
' ============================================================================
package "RAG Pipeline Ecosystem" as Ecosystem #FFEBEE {

  rectangle "rag-processor\n(Pipeline Frontend)" as RagProcessor #DCEDC8 {
    [Ingestion API]
    [Job Orchestration]
    [Status Tracking]
  }

  note right of RagProcessor
    **Repository:**
    github.com/ByronWilliamsCPA/rag-processor

    **Status:** In Development
    Unified interface for all
    media processing tracks
  end note

  package "Media Processing Tracks" as Tracks {

    rectangle "Image Track\n(THIS REPO)" as ImageTrack #E8F5E9 {
      [Project A\nPreprocessing & IQA]
    }

    rectangle "Audio Track" as AudioTrack #E3F2FD {
      [audio-processor\nTranscription & Diarization]
    }

    note bottom of AudioTrack
      **Repository:**
      github.com/ByronWilliamsCPA/audio-processor

      **Status:** In Development
      Parallel track for audio/video content
    end note
  }

  rectangle "Project B\nOCR Orchestration" as ProjectB #E0E0E0 {
    [NOT YET STARTED]
  }

  note left of ProjectB
    **Scope Change:**
    Layout analysis moved to Project A
    (DocLayout-YOLO with 11 classes)

    Project B now focused on:
    - Multi-engine OCR
    - Reading order
    - Table structure extraction
  end note

  rectangle "Project C\nFusion & Chunking" as ProjectC #E0E0E0

  rectangle "Project D\nVector Store" as ProjectD #E0E0E0

  note bottom of Ecosystem
    See: rag-pipeline-overview.puml
    for complete multi-track pipeline design
  end note
}

' Pipeline flow
RagProcessor --> ImageTrack : Documents\n(PDF/Image)
RagProcessor --> AudioTrack : Audio/Video
ImageTrack --> ProjectB : DocumentMetadata +\nCorrected Images
AudioTrack --> ProjectB : TranscriptMetadata +\nSegments
ProjectB --> ProjectC
ProjectC --> ProjectD
ProjectD --> RagProcessor : RAG-ready\ncollection ID

' ============================================================================
' PROJECT A - PRODUCTION RUNTIME
' ============================================================================
package "Project A: Production Runtime" as Production #E8F5E9 {

  component "Document Processing Pipeline" as Pipeline {
    portin "PDF/Image\nInput" as DocInput
    portout "DocumentMetadata.json\n+ Corrected Images" as DocOutput

    rectangle "Ingestion & Pre-flight" as Ingestion {
      [DPI Detection]
      [PDF Upscaling]
      [Page Extraction]
    }

    rectangle "Classification & Routing" as Classification {
      [PDF Type Classifier]
      [Text Gate]
    }

    rectangle "Quality Analysis" as Analysis {
      [Classical IQA\n(7 detectors)]
      [ML IQA Student\n(ResNet-18)]
      [ML IQA Teacher\n(ResNet-50)]
    }

    rectangle "Layout Analysis" as Layout {
      [DocLayout-YOLO\n(11 DocLayNet classes)]
      [Reading Order\nPrediction]
      [Table Structure\nExtraction]
    }

    rectangle "Correction & Scoring" as Correction {
      [Deskew/CLAHE/Denoise]
      [DQS Calculator]
      [Routing Engine]
    }
  }

  database "Model Registry\n(GCS)" as ModelRegistry

  note bottom of Pipeline
    **Primary Workflows:**
    - project-a-primary-workflow-high-level.puml
    - project-a-primary-workflow-detailed.puml

    **Supporting Workflows:**
    - project-a-device-selection-flow.puml (teacher escalation)
  end note
}

' ============================================================================
' MODEL TRAINING WORKSTREAM
' ============================================================================
package "Model Training Workstream" as Training #E3F2FD {

  component "IQA Model Training" as IQATraining {
    [ResNet-50 Teacher\nTraining]
    [Knowledge Distillation]
    [ResNet-18 Student\nTraining]
    [ONNX Export]
  }

  component "Layout Model Training" as LayoutTraining {
    [DocLayout-YOLO\nFine-tuning]
    [DocLayNet Dataset\n(11 classes)]
  }

  artifact "Production Models" as ProdModels {
    file "iqa_student.onnx"
    file "iqa_teacher.onnx"
    file "doclayout_yolo.onnx"
  }

  note right of IQATraining
    **Workflow:**
    project-a-distillation.puml

    **Design Goal:**
    Production-optimized models via
    knowledge distillation for
    speed/accuracy trade-off
  end note
}

' ============================================================================
' DATA PREPARATION WORKSTREAM
' ============================================================================
package "Data Preparation Workstream" as DataPrep #FFF3E0 {

  component "Dataset Ingestion" as DataIngestion {
    [Source Dataset\nCollection]
    [Normalization\n(300 DPI)]
    [Train/Val/Test\nSplits]
  }

  database "Raw Datasets" as RawData {
    [OHR-Bench]
    [DIQA-5000]
    [DocLayNet]
    [LIVE/CSIQ]
  }

  database "Processed Training Data\n(GCS)" as ProcessedData

  note right of DataIngestion
    **Workflow:**
    project-a-training-data-ingestion.puml

    **Purpose:**
    Unified data pipeline for
    heterogeneous source datasets
  end note
}

' ============================================================================
' PSEUDO-LABELING WORKSTREAM
' ============================================================================
package "Pseudo-Labeling Workstream" as PseudoLabeling #F3E5F5 {

  component "Multi-Model Ensemble" as Ensemble {
    rectangle "Track A: IQA Models" as TrackA {
      [MUSIQ\n(sharpness)]
      [QualiCLIP\n(color)]
      [DocIQ-Replica\n(overall)]
    }

    rectangle "Track B: VLM Models" as TrackB {
      [Qwen3-VL-8B\n(generalist)]
      [InternVL3-8B\n(overall)]
    }
  }

  component "Stacking & Calibration" as Stacking {
    [HierarchicalStacker]
    [Temperature Scaler]
    [Uncertainty Calculator]
  }

  artifact "Pseudo-Labels" as Labels {
    file "pseudo_labels.json"
    file "uncertainty_report.csv"
  }

  note right of Ensemble
    **Workflows:**
    - diqa-pseudo-labeling-workflow.puml
    - diqa-training-phases.puml
    - diqa-checkpoint-selection.puml
    - diqa-inference-pipeline.puml

    **Design Goal:**
    Maximum accuracy for label quality
    (not production deployment)
  end note
}

' ============================================================================
' CONNECTIONS - RUNTIME FLOW
' ============================================================================
Client --> DocInput : Source file
DocOutput --> ProjectB : AB Contract
ProjectB --> ProjectC
ProjectC --> ProjectD
ProjectD --> Client : RAG-ready ID

' ============================================================================
' CONNECTIONS - MODEL DEPLOYMENT
' ============================================================================
ProdModels --> ModelRegistry : Upload
ModelRegistry --> Analysis : Load models

' ============================================================================
' CONNECTIONS - TRAINING PIPELINE
' ============================================================================
RawData --> DataIngestion
DataIngestion --> ProcessedData
ProcessedData --> IQATraining : Training data
ProcessedData --> LayoutTraining : Training data
ProcessedData --> Ensemble : Inference data

' ============================================================================
' CONNECTIONS - LABELING PIPELINE
' ============================================================================
Labels --> ProcessedData : Enriched labels
Ensemble --> Stacking
Stacking --> Labels
IQATraining --> ProdModels

' ============================================================================
' DIAGRAM HIERARCHY
' ============================================================================
note as DiagramHierarchy
  **Diagram Hierarchy:**

  **Level 0: Context**
  └── rag-pipeline-overview.puml (multi-track pipeline)

  **Level 1: This Diagram**
  └── PROJECT_A_ARCHITECTURE_OVERVIEW.puml

  **Level 2: Production Runtime**
  ├── project-a-primary-workflow-high-level.puml
  ├── project-a-primary-workflow-detailed.puml
  └── project-a-device-selection-flow.puml

  **Level 2: Training Workstream**
  ├── project-a-distillation.puml
  └── (layout training - gap identified)

  **Level 2: Data Preparation**
  └── project-a-training-data-ingestion.puml

  **Level 2: Pseudo-Labeling**
  ├── diqa-pseudo-labeling-workflow.puml
  ├── diqa-training-phases.puml
  ├── diqa-checkpoint-selection.puml
  └── diqa-inference-pipeline.puml
end note

