' DATA PREPARATION WORKSTREAM
' ============================================================================
|Data Preparation|
start

partition "Dataset Collection" {
  :Collect source datasets;
  note right
    **Sources:**
    - OHR-Bench (IQA)
    - DIQA-5000 (IQA)
    - DocLayNet (Layout)
    - LIVE/CSIQ (IQA reference)

    **Workflow:**
    [[project-a-training-data-ingestion.puml]]

    **Documentation:**
    [[docs/DATASET_CATALOG.md]]

    **Scripts:**
    - scripts/download_*.py
    - scripts/annotate_base_metadata.py
  end note

  :Normalize to 300 DPI;
  :Create train/val/test splits;
  note right
    **Scripts:**
    - scripts/build_training_labels.py

    **Three-Layer Pipeline:**
    Layer 1: IMMUTABLE (annotate_base_metadata.py)
    Layer 2: ENRICHMENT (in same script)
    Layer 3: TRAINING (build_training_labels.py)
  end note
}

:Processed datasets\n(GCS: image_detection_b);

' ============================================================================
' PSEUDO-LABELING WORKSTREAM
' ============================================================================
|Pseudo-Labeling|

partition "Multi-Model Ensemble Training" {
  :Train Track A IQA models;
  note right
    **Models (accuracy-optimized):**
    - MUSIQ (sharpness specialist)
    - QualiCLIP (color specialist)
    - DocIQ-Replica (overall)

    **Workflow:**
    [[diqa-training-phases.puml]]
    Phase 1: Track A Training
  end note

  :Train Track B VLM models;
  note right
    **Models:**
    - Qwen3-VL-8B (LoRA)
    - InternVL3-8B (LoRA)

    **Workflow:**
    [[diqa-training-phases.puml]]
    Phase 2: Track B Training
  end note
}

partition "Checkpoint Selection" {
  :Select best checkpoints;
  note right
    **Algorithm:**
    Weighted SRCC + ECE scoring
    Band-based selection

    **Workflow:**
    [[diqa-checkpoint-selection.puml]]
  end note
}

partition "Ensemble Stacking" {
  :Train HierarchicalStacker;
  :Apply temperature scaling;
  note right
    **Workflow:**
    [[diqa-training-phases.puml]]
    Phase 3: Stacker Training
  end note
}

partition "Batch Inference" {
  :Run 5-model ensemble\non all datasets;
  note right
    **Infrastructure:**
    Modal serverless (A10G/A100)
    Parallel batch processing

    **Workflow:**
    [[diqa-inference-pipeline.puml]]

    **Scripts:**
    - modal/arena_benchmark.py
    - scripts/run_model_benchmark.py

    **Source:**
    - src/.../labeling/arena/runner.py
    - src/.../labeling/arena/inference/*.py

    **Documentation:**
    [[docs/benchmarks/README.md]]
  end note

  :Generate pseudo-labels\nwith uncertainty;
  note right
    **Output:**
    - overall/sharpness/color scores
    - per-model predictions
    - uncertainty flags

    **Workflow:**
    [[diqa-pseudo-labeling-workflow.puml]]

    **Scripts:**
    - modal/generate_pseudo_labels.py

    **Results:**
