{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/williaby/image-preprocessing-detector/document-metadata.schema.json",
  "title": "DocumentMetadata",
  "description": "Project A output schema for Project B handoff - Preprocessing, IQA & Coarse Layout Gateway",
  "type": "object",
  "required": [
    "document_id",
    "file_name",
    "source_mime",
    "num_pages",
    "pdf_type",
    "dqs",
    "pre_ocr_risk",
    "ocr_routing_recommendation",
    "page_layout_summary",
    "pages",
    "processing_version"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique document identifier",
      "examples": ["doc_20251125_001"]
    },
    "file_name": {
      "type": "string",
      "minLength": 1,
      "description": "Original input filename",
      "examples": ["contract_scan.pdf"]
    },
    "source_mime": {
      "type": "string",
      "description": "MIME type of source document",
      "examples": ["application/pdf", "image/png", "image/jpeg", "image/tiff"]
    },
    "num_pages": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of pages in document"
    },
    "pdf_type": {
      "type": "string",
      "enum": ["image_only", "born_digital", "hybrid"],
      "description": "Document classification for routing decisions"
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentLanguage"
      },
      "description": "Detected languages with ISO codes and script information"
    },
    "primary_script_family": {
      "type": "string",
      "enum": ["latin", "cjk", "arabic", "indic", "cyrillic", "other"],
      "description": "Primary script family for OCR engine selection"
    },
    "has_non_latin": {
      "type": "boolean",
      "default": false,
      "description": "Document contains non-Latin scripts (CJK, Arabic, Indic, etc.)"
    },
    "has_rtl": {
      "type": "boolean",
      "default": false,
      "description": "Document contains right-to-left scripts (Arabic, Hebrew)"
    },
    "pre_ocr_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Combined risk score for OCR difficulty (0=easy, 1=very difficult)"
    },
    "dqs": {
      "$ref": "#/$defs/DQSMetadata"
    },
    "ocr_routing_recommendation": {
      "type": "string",
      "enum": ["ocr_fast", "ocr_advanced", "vision_simple", "vision_structured"],
      "description": "Recommended OCR strategy for Project B"
    },
    "page_layout_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageLayoutSummary"
      },
      "description": "Per-page coarse layout attributes (NOT full semantic layout)"
    },
    "upscaling": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/UpscalingMetadata"}
      ],
      "description": "DPI upscaling metadata (present if upscaling was performed)"
    },
    "teacher_usage": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/TeacherUsage"}
      ],
      "description": "Teacher model escalation metadata"
    },
    "processing_version": {
      "$ref": "#/$defs/ProcessingVersion"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageMetadata"
      },
      "description": "Per-page detailed metadata"
    }
  },
  "$defs": {
    "DQSMetadata": {
      "type": "object",
      "required": ["degradation_score", "structural_complexity_score"],
      "properties": {
        "degradation_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Image degradation level (0=pristine, 1=severely degraded)"
        },
        "structural_complexity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Layout complexity (0=simple, 1=very complex)"
        }
      },
      "additionalProperties": false
    },
    "PageLayoutSummary": {
      "type": "object",
      "required": ["page_number", "layout_type", "complexity_score"],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based page number (note: PageMetadata uses 0-based page_index; convert with page_number = page_index + 1)"
        },
        "layout_type": {
          "type": "string",
          "enum": ["single_column", "multi_column", "three_column", "complex", "unknown"],
          "description": "Coarse layout classification"
        },
        "has_tables": {
          "type": "boolean",
          "default": false,
          "description": "Page contains tabular data"
        },
        "has_figures": {
          "type": "boolean",
          "default": false,
          "description": "Page contains images/diagrams"
        },
        "has_dense_math": {
          "type": "boolean",
          "default": false,
          "description": "Mathematical notation detected"
        },
        "has_handwriting": {
          "type": "boolean",
          "default": false,
          "description": "Handwritten content present"
        },
        "fuzzy_scan": {
          "type": "boolean",
          "default": false,
          "description": "Low-quality/blurry scan"
        },
        "watermark": {
          "type": "boolean",
          "default": false,
          "description": "Watermark overlay detected"
        },
        "colorful_background": {
          "type": "boolean",
          "default": false,
          "description": "Non-white background affects OCR"
        },
        "complexity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Structural complexity for routing (0=simple, 1=complex)"
        },
        "handwriting_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "DEPRECATED: Use handwriting_assessment.presence_score instead. Handwriting presence confidence for VLM escalation."
        },
        "handwriting_assessment": {
          "$ref": "#/$defs/HandwritingAssessment",
          "description": "Graded handwriting assessment (presence, legibility, content_type)"
        }
      },
      "additionalProperties": false
    },
    "HandwritingAssessment": {
      "type": "object",
      "description": "Graded handwriting assessment with orthogonal dimensions: presence, legibility, content type. Consensus-validated schema extension for DQS integration.",
      "properties": {
        "presence": {
          "type": "string",
          "enum": ["NONE", "SPARSE", "MODERATE", "SUBSTANTIAL", "DOMINANT"],
          "default": "NONE",
          "description": "Graded handwriting presence (quantity). NONE=0%, SPARSE=<10%, MODERATE=10-30%, SUBSTANTIAL=30-60%, DOMINANT=>60%"
        },
        "presence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Continuous presence score (handwriting area ratio 0-1)"
        },
        "presence_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Confidence in presence classification"
        },
        "legibility": {
          "type": "string",
          "enum": ["NOT_APPLICABLE", "EXCELLENT", "GOOD", "FAIR", "POOR", "ILLEGIBLE"],
          "default": "NOT_APPLICABLE",
          "description": "Graded legibility (readability quality). Based on clinical Handwriting Legibility Scale (HLS). Higher values = harder to read."
        },
        "legibility_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Continuous legibility score (0=illegible, 1=excellent)"
        },
        "legibility_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Confidence in legibility classification"
        },
        "content_type": {
          "type": "string",
          "enum": ["not_applicable", "signatures_marks", "numeric", "alphanumeric", "prose", "mixed", "specialized"],
          "default": "not_applicable",
          "description": "Content type classification. signatures_marks=signatures/initials, numeric=numbers only, alphanumeric=mixed short, prose=long-form, specialized=math/symbols"
        },
        "content_type_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Confidence in content type classification"
        },
        "detection_method": {
          "type": "string",
          "default": "none",
          "description": "Detection method: siglip2_multitask, heuristic, ground_truth, hiertext, cocotext"
        }
      },
      "additionalProperties": false
    },
    "UpscalingMetadata": {
      "type": "object",
      "required": ["performed"],
      "properties": {
        "performed": {
          "type": "boolean",
          "description": "Whether upscaling was applied"
        },
        "original_dpi": {
          "type": "integer",
          "minimum": 1,
          "description": "Original document DPI"
        },
        "target_dpi": {
          "type": "integer",
          "minimum": 1,
          "description": "Target DPI (typically 300)"
        },
        "algorithm": {
          "type": "string",
          "enum": ["lanczos", "bicubic", "inter_linear", "inter_cubic", "inter_area"],
          "description": "Upscaling algorithm used"
        },
        "processing_time_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Upscaling processing time in milliseconds"
        }
      },
      "additionalProperties": true
    },
    "TeacherUsage": {
      "type": "object",
      "properties": {
        "pages_with_teacher": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "description": "Page indices where teacher model was used"
        },
        "escalation_reasons": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "Mapping of page index to escalation reason"
        },
        "teacher_device": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"}
          ],
          "description": "Device used for teacher inference (cuda, cpu, modal)"
        },
        "total_teacher_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total teacher inference time in milliseconds"
        }
      },
      "additionalProperties": false
    },
    "ProcessingVersion": {
      "type": "object",
      "required": ["pipeline_version", "timestamp"],
      "properties": {
        "pipeline_version": {
          "type": "string",
          "description": "Semantic version of processing pipeline",
          "examples": ["1.0.0"]
        },
        "iqa_model_hash": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"}
          ],
          "description": "SHA256 hash of IQA model weights"
        },
        "layout_model_hash": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"}
          ],
          "description": "SHA256 hash of layout model weights"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": true,
          "description": "Configuration thresholds used during processing"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 processing timestamp"
        }
      },
      "additionalProperties": false
    },
    "PageMetadata": {
      "type": "object",
      "required": ["page_index", "width_px", "height_px", "dpi_input", "dpi_effective"],
      "properties": {
        "page_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based page index (note: PageLayoutSummary uses 1-based page_number; convert with page_index = page_number - 1)"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "description": "Page width in pixels"
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "description": "Page height in pixels"
        },
        "dpi_input": {
          "type": "integer",
          "minimum": 1,
          "description": "Original DPI of input"
        },
        "dpi_effective": {
          "type": "integer",
          "minimum": 1,
          "description": "DPI after processing (typically 300)"
        },
        "ml_iqa": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/MLIQAResult"}
          ],
          "description": "Student model ML IQA scores"
        },
        "teacher_iqa": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/MLIQAResult"}
          ],
          "description": "Teacher model IQA scores (if escalated)"
        },
        "detected_issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/DetectedIssue"},
          "default": [],
          "description": "Quality issues detected on this page"
        },
        "planned_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/PlannedAction"},
          "default": [],
          "description": "Correction actions planned"
        },
        "elements": {
          "type": "array",
          "items": {"$ref": "#/$defs/DocumentElement"},
          "default": [],
          "description": "Detected document elements"
        },
        "languages": {
          "type": "array",
          "items": {"$ref": "#/$defs/LanguageInfo"},
          "default": [],
          "description": "Detected languages/scripts"
        },
        "text_scope": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/TextScopeInfo"}
          ],
          "description": "Text content scope/granularity classification"
        },
        "paper_size": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/PaperSizeInfo"}
          ],
          "description": "ISO 216 paper size detection result"
        },
        "transform_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/TransformHistory"},
          "default": [],
          "description": "History of transformations applied"
        }
      },
      "additionalProperties": false
    },
    "MLIQAResult": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["student", "teacher"],
          "description": "Model that produced these scores"
        },
        "blur_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Sharpness score (0=blurry, 1=sharp)"
        },
        "noise_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Noise level (0=noisy, 1=clean)"
        },
        "contrast_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Contrast quality (0=poor, 1=good)"
        },
        "skew_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Alignment (0=skewed, 1=straight)"
        },
        "compression_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Compression artifacts (0=heavy, 1=clean)"
        },
        "overall_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weighted aggregate quality score"
        },
        "device": {
          "type": "string",
          "description": "Device used for inference (cuda, cpu, modal)"
        },
        "inference_time_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Inference time in milliseconds"
        },
        "escalation_reason": {
          "type": "string",
          "description": "Reason for teacher escalation (teacher only)"
        }
      },
      "additionalProperties": true
    },
    "DetectedIssue": {
      "type": "object",
      "required": ["type", "confidence", "severity"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["noise", "blur", "skew", "perspective", "low_contrast", "orientation", "low_dpi"],
          "description": "Type of quality issue"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Issue severity level"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional metrics specific to issue type"
        }
      },
      "additionalProperties": false
    },
    "PlannedAction": {
      "type": "object",
      "required": ["action", "confidence", "reason"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["deskew", "perspective_correction", "sharpen", "denoise", "clahe", "background_normalization", "upsample", "rotate"],
          "description": "Type of correction action"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Parameters for the correction"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in this action"
        },
        "reason": {
          "type": "string",
          "description": "Reason for this action"
        }
      },
      "additionalProperties": false
    },
    "DocumentElement": {
      "type": "object",
      "required": ["id", "category", "bbox", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique element identifier"
        },
        "category": {
          "type": "string",
          "enum": ["table", "image", "handwriting", "formula", "text_block", "figure"],
          "description": "Element category"
        },
        "bbox": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 4,
          "maxItems": 4,
          "description": "COCO format bounding box [x, y, width, height]"
        },
        "polygon": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {"type": "integer"},
                "minItems": 2,
                "maxItems": 2
              }
            }
          ],
          "description": "Optional polygon points for irregular shapes"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Additional element-specific attributes"
        },
        "quality_issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/DetectedIssue"},
          "default": [],
          "description": "Quality issues specific to this element"
        },
        "needs_correction": {
          "type": "boolean",
          "default": false,
          "description": "Whether element requires correction"
        },
        "correction_applied": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": true}
          ],
          "description": "Details of correction applied"
        }
      },
      "additionalProperties": false
    },
    "DocumentLanguage": {
      "type": "object",
      "description": "Document-level language detection with ISO codes",
      "required": ["language_code", "script_code"],
      "properties": {
        "language_code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$",
          "description": "ISO 639-1 (2-letter) or ISO 639-3 (3-letter) language code",
          "examples": ["en", "zh", "ar", "hi", "ja"]
        },
        "script_code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$",
          "description": "ISO 15924 script code",
          "examples": ["Latn", "Hans", "Arab", "Deva"]
        },
        "bcp47_tag": {
          "type": "string",
          "description": "BCP 47 language tag (e.g., 'zh-Hans', 'sr-Cyrl')"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "is_primary": {
          "type": "boolean",
          "default": false,
          "description": "True if this is the primary document language"
        }
      },
      "additionalProperties": false
    },
    "LanguageInfo": {
      "type": "object",
      "description": "Page-level language/script detection with ISO 15924",
      "required": ["script_code", "confidence"],
      "properties": {
        "language_code": {
          "type": ["string", "null"],
          "pattern": "^[a-z]{2,3}$",
          "description": "ISO 639-1/3 language code (if determinable)"
        },
        "script_code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$",
          "description": "ISO 15924 script code",
          "enum": [
            "Latn", "Hans", "Hant", "Jpan", "Kore", "Hani",
            "Deva", "Beng", "Taml", "Telu", "Gujr", "Knda", "Mlym", "Guru",
            "Thai", "Khmr", "Mymr", "Laoo", "Tibt",
            "Arab", "Hebr", "Cyrl", "Grek",
            "Zzzz"
          ]
        },
        "script_family": {
          "type": "string",
          "enum": ["latin", "cjk", "arabic", "indic", "cyrillic", "other"],
          "description": "Script family for routing"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "is_rtl": {
          "type": "boolean",
          "default": false,
          "description": "Right-to-left script"
        },
        "region": {
          "$ref": "#/$defs/COCOBoundingBox",
          "description": "Region where this script was detected (optional)"
        }
      },
      "additionalProperties": false
    },
    "COCOBoundingBox": {
      "type": "array",
      "description": "COCO-format bounding box [x, y, width, height]",
      "items": {"type": "number", "minimum": 0},
      "minItems": 4,
      "maxItems": 4
    },
    "TextScopeInfo": {
      "type": "object",
      "description": "Text content scope/granularity classification",
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["character", "word", "phrase", "sentence", "line", "paragraph", "page", "document", "mixed", "unknown"],
          "description": "Text scope from smallest (character) to largest (document)"
        },
        "content_type": {
          "type": "string",
          "enum": ["printed", "handwritten", "mixed", "scene_text", "synthetic", "unknown"],
          "description": "Primary content type classification"
        },
        "density": {
          "type": "string",
          "enum": ["sparse", "light", "moderate", "dense", "very_dense"],
          "description": "Text density based on text-to-image ratio"
        },
        "estimated_chars": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Estimated character count"
        },
        "estimated_words": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Estimated word count"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0-1)"
        },
        "detection_method": {
          "type": "string",
          "description": "How scope was determined",
          "examples": ["dataset_metadata", "ocr_output", "dimension_heuristic", "manual"]
        }
      },
      "additionalProperties": false
    },
    "PaperSizeInfo": {
      "type": "object",
      "description": "ISO 216 paper size detection result",
      "required": ["detected_size", "standard", "orientation"],
      "properties": {
        "detected_size": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "B4", "B5", "Letter", "Legal", "Tabloid", "Ledger", "Executive", "Half-Letter", "Statement", "Custom", "Unknown"],
          "description": "Detected paper size (ISO or ANSI standard)"
        },
        "standard": {
          "type": "string",
          "enum": ["iso", "ansi", "jis", "custom"],
          "description": "Paper size standard/region"
        },
        "width_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Actual width in millimeters"
        },
        "height_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Actual height in millimeters"
        },
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "description": "Page orientation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0-1)"
        },
        "is_exact_match": {
