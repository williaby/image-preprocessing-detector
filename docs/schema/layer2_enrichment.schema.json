{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/project-a/layer2-enrichment.schema.json",
  "title": "Layer2EnrichmentMetadata",
  "description": "Project A Layer 2 Enrichment Schema - Derived annotations with full provenance tracking",
  "type": "object",
  "required": ["sample_id", "enrichment_version", "created_at", "created_by", "method", "data"],
  "properties": {
    "sample_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID linking to Layer 1 sample record"
    },
    "enrichment_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version number of this enrichment (1, 2, 3...)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of enrichment creation"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "description": "Pipeline or tool that created this enrichment",
      "examples": ["annotate_base_metadata.py_v2.0.0", "doclayout_yolo_v1.0"]
    },
    "method": {
      "type": "string",
      "enum": ["tier_0_exact", "tier_1_annotation", "tier_2_model", "tier_3_heuristic"],
      "description": "Enrichment method tier for provenance tracking"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of enrichment"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "data": {
      "$ref": "#/$defs/EnrichmentData"
    }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "description": "Reproducibility and audit trail fields",
      "properties": {
        "git_sha": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{7,40}$",
          "description": "Git commit SHA at enrichment time"
        },
        "script_version": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+",
          "description": "Semantic version of enrichment script"
        },
        "model_checkpoint": {
          "type": ["string", "null"],
          "description": "Model checkpoint used (if tier_2_model)"
        },
        "config_hash": {
          "type": ["string", "null"],
          "description": "Hash of configuration used for reproducibility"
        }
      },
      "additionalProperties": false
    },
    "EnrichmentData": {
      "type": "object",
      "description": "Core enrichment data fields",
      "properties": {
        "capture_method": {
          "$ref": "#/$defs/CaptureMethodInfo"
        },
        "resolution": {
          "$ref": "#/$defs/ResolutionInfo"
        },
        "domain": {
          "$ref": "#/$defs/DomainInfo"
        },
        "structure": {
          "$ref": "#/$defs/StructureInfo"
        },
        "quality": {
          "$ref": "#/$defs/QualityInfo"
        },
        "language": {
          "$ref": "#/$defs/LanguageInfo"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageInfo"
          },
          "description": "All detected languages/scripts for multi-script documents. Use 'language' for single-script docs, or 'languages' for multi-script. The primary language should have is_primary=true."
        },
        "text_scope": {
          "$ref": "#/$defs/TextScopeInfo"
        },
        "paper_size": {
          "$ref": "#/$defs/PaperSizeInfo"
        },
        "content_flags": {
          "$ref": "#/$defs/ContentFlags"
        },
        "llm_scores": {
          "$ref": "#/$defs/LLMScores"
        },
        "layout_detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutDetection"
          },
          "description": "Detected layout elements (from YOLO or COCO)"
        },
        "handwriting_assessment": {
          "$ref": "#/$defs/HandwritingAssessment"
        },
        "text_content": {
          "$ref": "#/$defs/TextContent"
        },
        "text_statistics": {
          "$ref": "#/$defs/TextStatistics"
        }
      },
      "additionalProperties": false
    },
    "CaptureMethodInfo": {
      "type": "object",
      "description": "Capture method detection result",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["born_digital", "scanner_flatbed", "scanner_adf", "camera_professional", "camera_smartphone", "fax", "synthetic", "unknown"],
          "description": "Detected capture method"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "detection_method": {
          "type": "string",
          "description": "How capture method was determined",
          "examples": ["dataset_config", "pdf_metadata", "artifact_analysis"]
        }
      },
      "required": ["method"],
      "additionalProperties": false
    },
    "ResolutionInfo": {
      "type": "object",
      "description": "Resolution analysis result",
      "properties": {
        "dpi": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Detected DPI"
        },
        "category": {
          "type": "string",
          "enum": ["low_<150", "medium_150-299", "standard_300", "high_>300"],
          "description": "DPI category bin"
        },
        "pixels": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2,
          "maxItems": 2,
          "description": "Image dimensions [width, height]"
        }
      },
      "additionalProperties": false
    },
    "DomainInfo": {
      "type": "object",
      "description": "Document domain classification",
      "properties": {
        "level1": {
          "type": "string",
          "enum": ["TAX", "LEG", "FIN", "TEC", "SCI", "ADM", "MED", "EDU", "PER", "UNK"],
          "description": "Primary domain code"
        },
        "level2": {
          "type": ["string", "null"],
          "description": "Secondary domain code"
        },
        "level3": {
          "type": ["string", "null"],
          "description": "Tertiary domain code"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Classification confidence"
        }
      },
      "additionalProperties": false
    },
    "StructureInfo": {
      "type": "object",
      "description": "Document structure analysis",
      "properties": {
        "text_density": {
          "type": ["string", "null"],
          "enum": ["sparse", "moderate", "dense", null],
          "description": "Text density classification"
        },
        "layout_type": {
          "type": ["string", "null"],
          "enum": ["single_column", "multi_column", "three_column", "complex", "form_based", "tabular", "unknown", null],
          "description": "Layout type classification"
        },
        "element_types": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Detected element types present"
        }
      },
      "additionalProperties": false
    },
    "QualityInfo": {
      "type": "object",
      "description": "Quality and degradation assessment",
      "properties": {
        "overall_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Composite quality score (0=worst, 1=best)"
        },
        "degradations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Degradation"
          },
          "description": "List of detected degradations"
        }
      },
      "additionalProperties": false
    },
    "Degradation": {
      "type": "object",
      "description": "Single detected degradation",
      "required": ["type", "severity_numeric"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Degradation type from 45-type taxonomy",
          "examples": ["blur", "noise", "skew", "contrast", "compression", "bleed_through"]
        },
        "severity": {
          "type": "string",
          "enum": ["none", "mild", "moderate", "severe"],
          "description": "Categorical severity level"
        },
        "severity_numeric": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Numeric severity (0=none, 1=severe)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "detection_method": {
          "type": "string",
          "description": "Method used for detection",
          "examples": ["laplacian", "hough", "resnet18_student", "resnet50_teacher"]
        },
        "location": {
          "type": "string",
          "enum": ["global", "localized"],
          "description": "Whether degradation affects whole image or region"
        },
        "region": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 4,
              "maxItems": 4,
              "description": "COCO bbox [x, y, width, height] if localized"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LanguageInfo": {
      "type": "object",
      "description": "ISO-compliant language and script detection metadata",
      "properties": {
        "language_code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$",
          "description": "ISO 639-1 (2-letter) or ISO 639-3 (3-letter) language code",
          "examples": ["en", "zh", "ar", "hi", "ja", "ko", "ru"]
        },
        "script_code": {
          "type": "string",
          "pattern": "^[A-Z][a-z]{3}$",
          "description": "ISO 15924 script code (4-letter, Title case)",
          "enum": [
            "Latn", "Hans", "Hant", "Jpan", "Kore", "Hani",
            "Deva", "Beng", "Taml", "Telu", "Gujr", "Knda", "Mlym", "Orya", "Sinh", "Guru",
            "Thai", "Khmr", "Mymr", "Laoo", "Tibt",
            "Arab", "Hebr",
            "Cyrl", "Grek", "Armn", "Geor",
            "Ethi", "Hang", "Hira", "Kana",
            "Zyyy", "Zinh", "Zzzz"
          ],
          "examples": ["Latn", "Hans", "Arab", "Deva", "Cyrl"]
        },
        "bcp47_tag": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-[A-Z]{2})?$",
          "description": "BCP 47 / IETF language tag combining language-script-region",
          "examples": ["en", "zh-Hans", "zh-Hant", "sr-Cyrl", "ar-Arab"]
        },
        "script_family": {
          "type": "string",
          "enum": ["latin", "cjk", "arabic", "indic", "cyrillic", "other"],
          "description": "High-level script family for OCR routing decisions"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0-1)"
        },
        "detection_method": {
          "type": "string",
          "description": "Method used for language/script detection",
          "examples": ["dataset_metadata", "tesseract", "fasttext", "mlmodel", "manual"]
        },
        "is_rtl": {
          "type": "boolean",
          "default": false,
          "description": "True if script is right-to-left (Arabic, Hebrew)"
        },
        "is_primary": {
          "type": "boolean",
          "default": true,
          "description": "True if this is the primary/dominant language"
        }
      },
      "required": ["language_code", "script_code"],
      "additionalProperties": false
    },
    "TextScopeInfo": {
      "type": "object",
      "description": "Text content scope/granularity classification",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["character", "word", "phrase", "sentence", "line", "paragraph", "page", "document", "mixed", "unknown"],
          "description": "Text scope from smallest (character) to largest (document)"
        },
        "content_type": {
          "type": "string",
          "enum": ["printed", "handwritten", "mixed", "scene_text", "synthetic", "unknown"],
          "description": "Primary content type classification"
        },
        "density": {
          "type": "string",
          "enum": ["sparse", "light", "moderate", "dense", "very_dense"],
          "description": "Text density based on text-to-image ratio"
        },
        "estimated_chars": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Estimated character count"
        },
        "estimated_words": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Estimated word count"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0-1)"
        },
        "detection_method": {
          "type": "string",
          "description": "How scope was determined",
          "examples": ["dataset_metadata", "ocr_output", "dimension_heuristic", "manual"]
        }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "PaperSizeInfo": {
      "type": "object",
      "description": "ISO 216 paper size detection result",
      "properties": {
        "detected_size": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "B4", "B5", "Letter", "Legal", "Tabloid", "Ledger", "Executive", "Half-Letter", "Statement", "Custom", "Unknown"],
          "description": "Detected paper size (ISO or ANSI standard)"
        },
        "standard": {
          "type": "string",
          "enum": ["iso", "ansi", "jis", "custom"],
          "description": "Paper size standard/region"
        },
        "width_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Actual width in millimeters"
        },
        "height_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Actual height in millimeters"
        },
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "description": "Page orientation"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence (0-1)"
        },
        "is_exact_match": {
          "type": "boolean",
          "description": "True if dimensions match standard size exactly (<0.5% deviation)"
        }
      },
      "required": ["detected_size", "standard", "orientation"],
      "additionalProperties": false
    },
    "ContentFlags": {
      "type": "object",
      "description": "Content type flags with provenance",
      "properties": {
        "has_table": {
          "type": ["boolean", "null"],
          "description": "Document contains tabular data"
        },
        "has_formula": {
          "type": ["boolean", "null"],
          "description": "Document contains mathematical formulas"
        },
        "has_handwriting": {
          "type": ["boolean", "null"],
          "description": "Document contains handwritten content"
        },
        "has_signature": {
          "type": ["boolean", "null"],
          "description": "Document contains signatures"
        },
        "has_figure": {
          "type": ["boolean", "null"],
          "description": "Document contains figures/images"
        },
        "tier": {
          "type": "string",
          "enum": ["tier_0_exact", "tier_1_annotation", "tier_2_model", "tier_3_heuristic"],
          "description": "Enrichment tier that determined these flags"
        },
        "source": {
          "type": "string",
          "description": "Specific source of content flags",
          "examples": ["tier_0_exact_by_construction", "coco_annotation", "doclayout_yolo", "dataset_heuristic"]
        }
      },
      "additionalProperties": false
    },
    "LLMScores": {
      "type": ["object", "null"],
      "description": "LLM-predicted perceptual quality scores",
      "properties": {
        "predicted_mos": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Predicted Mean Opinion Score (1-5 scale)"
        },
        "predicted_normalized": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Normalized quality score (0=worst, 1=best)"
        },
        "prediction_confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Model confidence in prediction"
        },
        "model_name": {
          "type": ["string", "null"],
          "description": "LLM model used for prediction",
          "examples": ["llama3.2-vision-diqa-ft-v1", "gpt-4-vision"]
        }
      },
      "additionalProperties": false
    },
    "LayoutDetection": {
      "type": "object",
      "description": "Single layout element detection with standardized COCO bbox format",
      "required": ["class_name", "bbox", "confidence", "source"],
      "properties": {
        "class_name": {
          "type": "string",
          "description": "Element class name (DocLayNet 11-class taxonomy)",
          "enum": ["Caption", "Footnote", "Formula", "List-Item", "Page-Footer", "Page-Header", "Picture", "Section-Header", "Table", "Text", "Title"],
          "examples": ["Table", "Formula", "Picture", "Text", "Section-Header"]
        },
        "bbox": {
          "$ref": "#/$defs/COCOBoundingBox"
        },
        "bbox_original": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 4,
              "maxItems": 4,
              "description": "Original bbox before COCO conversion (for audit)"
            }
          ]
        },
        "bbox_source_format": {
          "type": "string",
          "enum": ["coco_xywh", "xyxy", "yolo_normalized"],
          "default": "coco_xywh",
          "description": "Original format before standardization"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Detection confidence"
        },
        "source": {
          "type": "string",
          "description": "Detection source",
          "examples": ["doclayout_yolo", "coco_annotation", "tablebank", "funsd"]
        },
        "area": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Bounding box area in pixels (width * height)"
        }
      },
      "additionalProperties": false
    },
    "COCOBoundingBox": {
      "type": "array",
      "description": "COCO-format bounding box [x, y, width, height] where (x,y) is top-left corner",
      "items": {"type": "number", "minimum": 0},
      "minItems": 4,
      "maxItems": 4,
      "examples": [[100, 200, 300, 150]]
    },
    "TextContent": {
      "type": "object",
      "description": "Extracted or ground truth text content. This is the standardized storage location for text from any source (GT labels, OCR, transcription). Text statistics are computed from this field.",
      "properties": {
        "full_text": {
          "type": "string",
          "description": "Complete text content, concatenated if from multiple regions. Newlines preserved."
        },
        "segments": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/TextSegment"
          },
          "description": "Optional segmented text with region/line-level granularity. Use when source provides positional info."
        },
        "source_type": {
          "type": "string",
          "enum": ["ground_truth", "ocr_tesseract", "ocr_doctr", "ocr_paddleocr", "ocr_easyocr", "transcription", "synthetic", "dataset_provided"],
          "description": "Origin of the text content"
        },
        "source_file": {
          "type": ["string", "null"],
          "description": "Original file path or annotation ID the text was extracted from"
        },
        "source_format": {
          "type": ["string", "null"],
          "description": "Format of the source (e.g., 'coco_text_annotation', 'txt_file', 'xml_alto', 'json_ocr')",
          "examples": ["coco_text_annotation", "txt_file", "xml_alto", "json_ocr", "hocr"]
        },
        "extraction_method": {
          "type": ["string", "null"],
          "description": "Parser or script that performed the extraction",
          "examples": ["parse_cocotext_labels", "parse_iam_transcription", "doctr_v0.8"]
        },
        "extraction_timestamp": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 timestamp when text was extracted"
        },
        "language_hint": {
          "type": ["string", "null"],
          "pattern": "^[a-z]{2,3}$",
          "description": "ISO 639 language code if known from source metadata"
        },
        "encoding": {
          "type": "string",
          "default": "utf-8",
          "description": "Text encoding (always normalized to UTF-8 in storage)"
        },
        "is_complete": {
          "type": "boolean",
          "default": true,
          "description": "False if text is partial (e.g., only visible text regions, truncated)"
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence in text accuracy (for OCR sources)"
        }
      },
      "required": ["full_text", "source_type"],
      "additionalProperties": false
    },
    "TextSegment": {
      "type": "object",
      "description": "A segment of text with optional positional information",
      "properties": {
        "text": {
          "type": "string",
          "description": "Text content of this segment"
        },
        "segment_type": {
          "type": "string",
          "enum": ["line", "paragraph", "word", "region", "block", "cell"],
          "description": "Granularity level of this segment"
        },
        "bbox": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 4,
              "maxItems": 4,
              "description": "COCO bbox [x, y, width, height] if positional info available"
            }
          ]
        },
        "sequence_index": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Reading order index within the document"
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence for this specific segment (OCR)"
        },
        "parent_element_id": {
          "type": ["string", "null"],
          "description": "Reference to layout_detections element if text is from a detected region"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "TextStatistics": {
      "type": "object",
      "description": "Precise text statistics computed from text_content field. Only populated when text_content is available.",
      "properties": {
        "character_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of characters (including spaces and punctuation)"
        },
        "character_count_no_spaces": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Character count excluding whitespace"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of words (whitespace-delimited tokens)"
        },
        "sentence_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of sentences (detected via punctuation: . ! ?)"
        },
        "paragraph_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of paragraphs (detected via double newlines or explicit markers)"
        },
        "line_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of text lines (single newline delimited)"
        },
        "avg_word_length": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Average word length in characters"
        },
        "avg_sentence_length": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Average sentence length in words"
        },
        "avg_paragraph_length": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Average paragraph length in sentences"
        },
        "text_source": {
          "type": "string",
          "description": "Source of the text content",
          "enum": ["ground_truth", "ocr_tesseract", "ocr_doctr", "ocr_paddleocr", "transcription", "synthetic"],
          "examples": ["ground_truth", "ocr_tesseract"]
        },
        "text_source_file": {
          "type": ["string", "null"],
          "description": "Path or identifier of the source text file/annotation"
        },
        "computation_method": {
          "type": "string",
          "description": "Method used for tokenization and counting",
          "examples": ["nltk", "spacy", "regex_simple", "unicode_segmentation"]
        }
      },
      "required": ["character_count", "word_count", "text_source"],
      "additionalProperties": false
    },
    "HandwritingAssessment": {
      "type": "object",
      "description": "Graded handwriting assessment with orthogonal dimensions: presence, legibility, content type. Consensus-validated schema extension for DQS integration.",
      "properties": {
        "presence": {
          "type": "string",
