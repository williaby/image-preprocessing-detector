@startuml automated-data-labeling-pipeline
!theme plain
title Phase 7/9 Automated Data Labeling Pipeline

skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle

' Color definitions
skinparam component {
    BackgroundColor<<immutable>> LightBlue
    BackgroundColor<<enrichment>> LightGreen
    BackgroundColor<<training>> LightYellow
    BackgroundColor<<output>> LightGray
    BackgroundColor<<external>> LightPink
}

package "Data Sources (E: Drive)" as sources {
    database "01_base_data/" as base_data <<external>> {
        collections degraded
        collections documents
        collections forms
        collections tables
        collections handwriting
        collections formulas
        collections educational
    }

    database "02_benchmark_only/" as benchmark <<external>> {
        collections "DIQA-5000\n(human MOS)"
        collections "LIVE/CSIQ\n(human DMOS)"
        collections "SmartDoc-QA"
        collections "DIBCO"
    }
}

package "Layer 1: IMMUTABLE (annotate_base_metadata.py)" as layer1 <<immutable>> {
    component "Image Scanner" as scanner {
        [File Discovery\n(glob patterns)]
        [SHA256 Hashing]
        [PIL Metadata\nExtraction]
    }

    component "Label Parsers" as parsers {
        [parse_diqa_labels\n(MOS scores)]
        [parse_doclaynet_labels\n(COCO bboxes)]
        [parse_tablebank_labels\n(COCO bboxes)]
        [parse_funsd_labels\n(form annotations)]
        [parse_signatr_labels\n(writer IDs)]
    }

    component "Original Data" as original {
        [OriginalFileMetadata\n- format, dimensions\n- DPI, color_space]
        [OriginalLabels\n- diqa_mos, live_dmos\n- doclaynet_annotations\n- tablebank_annotations]
    }
}

package "Layer 2: ENRICHMENT (annotate_base_metadata.py)" as layer2 <<enrichment>> {
    component "Dataset Config" as config {
        [capture_method\n(SCANNER_ADF, BORN_DIGITAL, etc.)]
        [domain_level1\n(TAX, FIN, EDU, etc.)]
        [Phase 9 Flags\n(has_table, has_formula,\nhas_handwriting, has_signature)]
    }

    component "EnrichmentData" as enrichment {
        [resolution_dpi\nresolution_category\nresolution_pixels]
        [capture_confidence\ndomain_confidence]
        [LLM predictions\n(future enrichment)]
    }

    component "Versioning" as versioning {
        [EnrichmentVersion\n- version number\n- created_at\n- created_by\n- method]
    }
}

package "Layer 3: TRAINING (build_training_labels.py)" as layer3 <<training>> {
    component "Score Normalization" as normalize {
        [MOS/DMOS → 0-1 scale]
        [anchor_score computation]
        [anchor_source priority\n(human > llm_high > synthetic)]
    }

    component "IQA Vector Builder" as iqa_builder {
        [45-dim iqa_vector\n(one per degradation type)]
        [iqa_binary\n(thresholded presence)]
        [DEGRADATION_INDEX\nmapping]
    }

    component "Element Labels" as element_labels {
        [ElementLabel extraction\nfrom COCO annotations]
        [table_type classification]
        [formula_complexity]
        [signature_locations]
    }
}

package "Output Artifacts" as outputs <<output>> {
    file "metadata_registry/\njson/*.json" as json_out
    file "metadata_registry/\nsamples.parquet" as parquet_out
    file "training_labels.parquet" as training_out

    note right of parquet_out
        Flat columns for filtering:
        - Phase 9 flags
        - element counts
        - JSON-serialized bboxes
    end note

    note right of training_out
        Training-ready labels:
        - iqa_vector (45-dim)
        - anchor_score
        - element_labels
    end note
}

' Flow connections
base_data --> scanner
benchmark --> scanner
scanner --> parsers : "per-image\nprocessing"
parsers --> original : "extract\nlabels"

original --> enrichment : "combine with\nconfig defaults"
config --> enrichment
enrichment --> versioning : "track\nprovenance"

original --> json_out : "full detail\nper dataset"
enrichment --> parquet_out : "flat view\nwith bboxes"
versioning --> json_out

parquet_out --> normalize : "read JSON\nregistry"
json_out --> normalize
normalize --> iqa_builder
normalize --> element_labels
iqa_builder --> training_out
element_labels --> training_out

' Performance note
note bottom of layer1
    **COCO Cache Optimization**
    Load annotations once per dataset,
    not per image (~100x faster)
end note

' Architecture note
note right of layer3
    **Three-Layer Architecture**
    Immutable: Original source data
    Enrichment: Our derived annotations
    Training: Computed on-demand
end note

@enduml
