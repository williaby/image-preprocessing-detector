# Image Preprocessing Detector Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Phase 1B: PDF Resolution Pre-processing & DPI Upscaling
# =============================================================================

# Enable PDF upscaling for low-resolution documents
IMAGE_PREP_ENABLE_PDF_UPSCALING=true

# Minimum DPI threshold - documents below this will be upscaled
IMAGE_PREP_PDF_MIN_DPI=300

# Target DPI for upscaling
IMAGE_PREP_PDF_TARGET_DPI=300

# Upscaling algorithm
# Options: lanczos (best quality), bicubic (balanced), inter_linear (fastest),
#          inter_cubic (high quality), inter_area (downsampling)
IMAGE_PREP_PDF_UPSCALE_ALGORITHM=lanczos

# Preserve original file if upscaling fails (recommended: true for safety)
IMAGE_PREP_PDF_PRESERVE_ORIGINAL_ON_ERROR=true

# =============================================================================
# Future Configuration Sections
# =============================================================================

# Phase 2: Image Quality Assessment
# (Configuration to be added in Phase 2)

# Phase 3: Document Layout Detection
# (Configuration to be added in Phase 3)

# Phase 4: Production Settings
# (Configuration to be added in Phase 4)

# =============================================================================
# Model Artifact Storage (GCS + Hugging Face Hub)
# =============================================================================

# GCS Bucket for RAG Pipeline Models
# This is the canonical storage bucket for all training artifacts
GCS_BUCKET_NAME=rag-pipeline-models

# GCS Project ID
# The Google Cloud project containing the bucket
GCP_PROJECT_ID=your-gcp-project-id

# Google Application Credentials
# Path to your service account JSON key file
# SECURITY: Never commit this file to version control!
# For Modal: This should be base64-encoded and stored in Modal secrets
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account-key.json

# Hugging Face Hub Configuration
# For model promotion to Hugging Face Hub

# Hugging Face API Token
# Create at: https://huggingface.co/settings/tokens
# SECURITY: Never commit this to version control!
# For GitHub Actions: Store as a repository secret
HF_TOKEN=your-huggingface-token-here

# Hugging Face Username/Organization
# Used for repository naming (e.g., username/model-name)
HF_USERNAME=your-hf-username

# Modal Configuration
# These are set automatically by Modal when using secrets

# GCS credentials for Modal (base64-encoded service account JSON)
# Set via: ./scripts/modal_helpers.sh setup-gcs-secret /path/to/key.json
# GCP_SA_KEY=<base64-encoded-service-account-json>

# Model Storage Configuration

# Default project name for artifact storage
MODEL_PROJECT_NAME=image-preprocessing-detector

# Dataset version tracking
# Update this when using a new dataset version
DATASET_VERSION=v1.0.0

# Training Configuration

# Enable debug mode for verbose logging
DEBUG=false

# Random seed for reproducibility
RANDOM_SEED=42
