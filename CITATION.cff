    family-names: Williams
    orcid: "https://orcid.org/0009-0005-5244-6084"
license: MIT
repository-code: "https://github.com/williaby/image-preprocessing-detector"
keywords:
  - RAG
  - image quality assessment
  - OCR preprocessing
  - OpenCV
  - Python
