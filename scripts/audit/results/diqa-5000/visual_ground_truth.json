{
  "dataset": "diqa-5000",
  "audit_date": "2026-02-10",
  "inspector": "claude-opus-4-6",
  "total_samples": 36,
  "methodology": "Visual inspection of each image via Read tool, recording ground truth for all Layer 2 schema fields",
  "critical_findings": {
    "orientation_issues": {
      "description": "6/36 images (17%) are rotated 90 degrees clockwise - orientation detection is critical",
      "affected_samples": ["train_ori_00027", "train_ori_00291", "train_res_02781", "val_ori_00006", "test_res_00910", "val_res_00414", "train_res_02274", "train_res_00334"],
      "count": 8,
      "pct": 22.2
    },
    "openlid_misclassification": {
      "description": "OpenLID classified English+Chinese handwritten document as Assamese/Bengali (0.767 confidence)",
      "affected_sample": "test_ori_00045",
      "openlid_prediction": {"language": "as", "script": "Beng", "confidence": 0.767},
      "actual": {"language": "en+zh", "script": "Latn+Hans"},
      "root_cause": "OpenLID struggles with handwritten content and mixed-language documents"
    },
    "finger_occlusion": {
      "description": "Camera-captured ori/ images often show fingers holding the paper",
      "affected_samples": ["train_ori_00027", "train_ori_00291", "val_ori_00006", "train_res_00334"],
      "count": 4,
      "pct": 11.1,
      "note": "Some res/ images retain finger artifacts from their ori/ originals"
    },
    "code_content": {
      "description": "Multiple images contain programming code, which is not captured by current schema content flags",
      "affected_samples": ["train_res_01045", "train_res_01832", "test_res_00207", "train_res_03064"],
      "count": 4,
      "pct": 11.1,
      "note": "Schema should consider has_code flag; current has_formula may partially cover this"
    },
    "ai_generated_content": {
      "description": "At least one image appears to be AI chatbot output (CopyEdit labels)",
      "affected_samples": ["train_res_03064"],
      "note": "Document origin is AI-generated text, not traditional born-digital or scanned"
    },
    "screen_capture_indicator": {
      "description": "UI toolbar visible in one image suggesting screen/tablet capture rather than paper photograph",
      "affected_samples": ["test_res_00568"],
      "note": "Moiré distortion type may be from screen capture, not paper scanning"
    }
  },
