# =============================================================================
# Image Detection Project - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# WARNING: Never commit .env to version control (it's in .gitignore)

# =============================================================================
# CI/CD & External Services
# =============================================================================

# Codecov (code coverage reporting)
CODECOV_TOKEN=

# HuggingFace Token (for dataset downloads)
# To use: huggingface-cli login --token $HF_TOKEN
# GitHub Secret: Create HF_TOKEN secret with this same value
HF_TOKEN=

# Kaggle credentials (JSON base64 encoded)
# Format: {"username": "your_username", "key": "your_api_key"}
# To encode: echo '{"username":"...","key":"..."}' | base64
KAGGLE_JSON=

# =============================================================================
# GCP Configuration
# =============================================================================

# GCP Service Account Key (base64 encoded)
# To decode: echo $GCP_SA_KEY | base64 -d > service-account.json
# GitHub Secret: Update GCP_SA_KEY secret with this same base64 value
GCP_SA_KEY=

# GCS Bucket for RAG Pipeline Models (canonical storage)
GCS_BUCKET_NAME=rag-pipeline-models

# GCP Project ID (extracted from service account)
GCP_PROJECT_ID=image-detection-478105

# Model Storage Configuration
MODEL_PROJECT_NAME=image-preprocessing-detector

# Dataset version tracking (update when using new dataset versions)
DATASET_VERSION=v1.0.0

# HMAC Keys for GCS access
GOOGLE_ACCESS_KEY_ID=
GOOGLE_ACCESS_KEY_SECRET=

# =============================================================================
# Training Configuration
# =============================================================================

DEBUG=false
RANDOM_SEED=42

# =============================================================================
# MCP Server Environment Variables
# =============================================================================
# Configuration for Model Context Protocol (MCP) servers used by Claude Code
# See: docs/reference/MCP_SERVER_SETUP.md

# GitHub MCP Server (REQUIRED for code review, PR operations, repository access)
# Create token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# PostgreSQL MCP Server (OPTIONAL - for database query analysis)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/image_detection
DATABASE_URL=

# Sentry MCP Server (OPTIONAL - for error monitoring integration)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# Context7 MCP Server (OPTIONAL - for enhanced library documentation caching)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
