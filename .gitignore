# Data (large files stored in GCS)
# Allow documentation and test fixtures
!data/README.md
!data/**/README.md
!data/test_fixtures/


# Exclude all data subdirectories (actual datasets)
data/iqa/
data/layout/
data/test/
data/annotations/
data/augmented/
data/benchmarks/*
data/downloads/
data/labels/
data/promptcraft/
data/raw/
data/training/*
# Top-level datasets directory for training data (not src/*/datasets/ modules)
/datasets/
data/

# DVC tracking
# *.dvc  # Commented to allow .dvc tracking files
.dvc/*  # Ignore DVC cache and internal files
!.dvc/config  # Keep DVC config
!.dvc/.gitignore  # Keep DVC's own gitignore

# Models (large files)
models/**/*.pth
models/**/*.onnx
models/**/*.pt
models/**/*.safetensors
!models/.gitkeep

# Temporary files
tmp/
tmp_cleanup/
*.tmp

# Logs
logs/
*.log

# Environment variables
.env
.env.local

# Claude Code local settings (may contain API keys or secrets)
.claude/settings.local.json

# GCS service account keys (base64 encoded)
*.b64
*.json.b64
*service-account*.json

# Documentation
site/
docs/_build/

# CI/CD
.github/workflows/*.log

