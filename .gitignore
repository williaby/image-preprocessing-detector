# Data (large files stored in GCS)
# Allow documentation and test fixtures
!data/README.md
!data/**/README.md
!data/test_fixtures/


# Exclude all data subdirectories (actual datasets)
data/iqa/
data/layout/
data/test/
data/annotations/
data/augmented/
data/benchmarks/*
data/downloads/
data/labels/
data/promptcraft/
data/raw/
data/training/*
datasets/

# DVC tracking
# *.dvc  # Commented to allow .dvc tracking files
.dvc/*  # Ignore DVC cache and internal files
!.dvc/config  # Keep DVC config
!.dvc/.gitignore  # Keep DVC's own gitignore

# Models (large files)
models/**/*.pth
models/**/*.onnx
models/**/*.pt
models/**/*.safetensors
!models/.gitkeep

# Temporary files
tmp/
tmp_cleanup/
*.tmp

# Logs
logs/
*.log

# Environment variables
.env
.env.local

# Claude Code local settings (may contain API keys or secrets)
.claude/settings.local.json

# GCS service account keys (base64 encoded)
*.b64
*.json.b64
*service-account*.json

# Documentation
site/
docs/_build/

# CI/CD
.github/workflows/*.log

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Training datasets (large files, managed by DVC or downloaded)
# data/training/  # Commented - already covered above, and we need .dvc files

# SignaTR6K dataset (large benchmark)
data/SignaTR6K.zip

# Validation (experimental one-off scripts and artifacts)
validation/*.py
validation/*.sh
validation/datasets/
validation/synthetic_images/
validation/characteristic_curves/
validation/*.json

# Security scanning output
bandit-*.json
sbom-*.json

# Modal
.modal/
__modal_cache__/
modal_cache/
*modal-token*
.modal-token
# Keep lightweight DVC pointer files even though dataset contents are ignored
!data/**/*.dvc
tmp_comments.json
tests/fixtures/phase2_validation/*.pdf
tests/fixtures/phase2_validation/**/*.pdf
