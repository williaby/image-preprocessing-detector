*.cvsi-update

# YOLO inference runs
runs/

# Audit results (generated per-dataset artifacts, not source code)
scripts/audit/results/

# Results (local analysis outputs, not tracked)
results/

# Generated PR tracking documents (auto-generated by check_unresolved_pr_comments.py)
docs/planning/UNRESOLVED_PR_COMMENTS_TRACKING.md
docs/planning/UNRESOLVED_SECURITY_COMMENTS.md

