# Docker ignore file for Image Preprocessing Detector
# Reduces build context size and prevents sensitive files from being included

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
*.whl

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Documentation
docs/_build/
site/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Project specific
tmp_cleanup/
notebooks/
validation/
benchmarks/data/
# Note: fuzz/ is NOT excluded because ClusterFuzzLite needs it
modal/

# Logs and temporary files
logs/
*.log
tmp/
*.tmp
.tmp-*

# Data (mount as volumes instead)
data/
models/
*.onnx
*.pt
*.pth
*.safetensors
*.bin

# Environment files (security)
.env
.env.*
!.env.example
*.key
*.pem

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
template_feedback/

# Kubernetes manifests (separate deployment)
k8s/

# Docker files (don't nest)
Dockerfile*
docker-compose*.yaml
.dockerignore

# Development files
CLAUDE.md
CHANGELOG.md
CONTRIBUTING.md
Makefile
noxfile.py
conftest.py
pyproject.toml.bak

# Tests (optional - uncomment to exclude tests from production image)
# tests/

# OS
.DS_Store
Thumbs.db
